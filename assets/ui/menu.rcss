/* Settings menu. RmlUi has no user-agent stylesheet: block elements are declared here. */

body, div, p { display: block; }
span { display: inline-block; }

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    font-size: 17dp;
    color: #e8e6e1;
    background-color: rgba(0, 0, 0, 110);
}

#panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 820dp;
    height: 560dp;
    margin-left: -410dp;
    margin-top: -280dp;
    padding: 18dp 22dp;
    box-sizing: border-box;
    border-radius: 14dp;
    background-color: rgba(16, 18, 26, 205);
    border: 1dp rgba(255, 255, 255, 30);
    backdrop-filter: blur(14dp);
    display: flex;
    flex-direction: column;
}

/* Buttons and form controls: focusable and reachable with arrow keys / the D-pad. */
button, input {
    tab-index: auto;
    focus: auto;
    nav: auto;
    cursor: pointer;
}

button {
    display: inline-block;
    padding: 7dp 14dp;
    border-radius: 7dp;
    background-color: rgba(255, 255, 255, 14);
    border: 1dp rgba(255, 255, 255, 25);
    text-align: center;
    transition: background-color 0.12s;
}
button:hover { background-color: rgba(255, 255, 255, 34); }
button:focus { background-color: rgba(214, 169, 92, 90); border-color: #d6a95c; }
button:active { background-color: rgba(214, 169, 92, 140); }

#tabs {
    display: flex;
    flex-direction: row;
    margin-bottom: 14dp;
    border-bottom: 1dp rgba(255, 255, 255, 30);
    padding-bottom: 12dp;
}
.tab {
    margin-right: 10dp;
    padding: 8dp 22dp;
    font-size: 19dp;
    font-weight: bold;
    background-color: transparent;
    border-color: transparent;
    color: #a9a59c;
}
.tab.selected { color: #f3e3c3; border-color: #d6a95c; }
.tab:focus { color: #ffffff; }

.page {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

.table-header {
    display: flex;
    flex-direction: row;
    padding: 0 12dp 8dp 12dp;
    color: #a9a59c;
    font-size: 15dp;
}
.table-header .name { flex: 1; }
.table-header .column { width: 230dp; margin-left: 10dp; text-align: center; }

#bindings {
    flex: 1;
    overflow-y: auto;
    padding-right: 6dp;
}
.binding {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4dp 12dp;
    border-radius: 6dp;
}
.binding:hover { background-color: rgba(255, 255, 255, 8); }
.binding .name { flex: 1; }
.bind { width: 230dp; margin-left: 10dp; font-size: 15dp; }
.bind.capturing { background-color: rgba(214, 169, 92, 170); color: #1b1610; }

scrollbarvertical { width: 8dp; }
scrollbarvertical slidertrack { background-color: rgba(255, 255, 255, 10); border-radius: 4dp; }
scrollbarvertical sliderbar { background-color: rgba(255, 255, 255, 60); border-radius: 4dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

.setting {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12dp;
}
.setting .name { width: 200dp; }
.setting .value { margin-left: 14dp; width: 60dp; }
.setting .note { margin-left: 14dp; color: #8d897f; font-size: 14dp; }

input.range {
    width: 320dp;
    height: 22dp;
}
input.range slidertrack {
    margin-top: 9dp;
    height: 4dp;
    border-radius: 2dp;
    background-color: rgba(255, 255, 255, 50);
}
input.range sliderbar {
    width: 18dp;
    height: 18dp;
    margin-top: 2dp;
    border-radius: 9dp;
    background-color: #e8e6e1;
}
input.range:focus sliderbar { background-color: #d6a95c; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }

input.checkbox {
    width: 24dp;
    height: 24dp;
    border-radius: 5dp;
    border: 2dp rgba(255, 255, 255, 90);
    background-color: rgba(255, 255, 255, 10);
}
input.checkbox:checked { background-color: #d6a95c; border-color: #d6a95c; }
input.checkbox:focus { border-color: #f3e3c3; }

.footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 12dp;
}
.action { padding: 8dp 18dp; }

#hints {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 12dp;
    padding-top: 12dp;
    border-top: 1dp rgba(255, 255, 255, 30);
    color: #8d897f;
    font-size: 14dp;
}
#hints span { margin-right: 24dp; }
#hints button { margin-left: auto; font-size: 15dp; color: #e8e6e1; }
