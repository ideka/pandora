<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body data-model="settings">
<div id="panel">
    <div id="tabs">
        <button id="tab-controls" class="tab" data-class-selected="tab == 'controls'" data-event-click="set_tab('controls')">Controls</button>
        <button id="tab-sound" class="tab" data-class-selected="tab == 'sound'" data-event-click="set_tab('sound')">Sound</button>
        <button id="tab-general" class="tab" data-class-selected="tab == 'general'" data-event-click="set_tab('general')">General</button>
    </div>

    <div class="page" data-if="tab == 'controls'">
        <div id="devices">
            <button id="dev-gamepad" class="device" data-class-selected="device == 'gamepad'" data-event-click="set_device('gamepad')">Gamepad</button>
            <button id="dev-kbm" class="device" data-class-selected="device == 'kbm'" data-event-click="set_device('kbm')">Keyboard &amp; Mouse</button>
        </div>
        <div class="table-header">
            <span class="name"></span>
            <span class="column">Mapping 1</span>
            <span class="spacer"></span>
            <span class="column">Mapping 2</span>
            <span class="spacer"></span>
        </div>
        <div id="bindings">
            <div class="section">Wii Remote + Nunchuk</div>
            <div class="binding" data-for="row : wii_rows">
                <span class="name">{{ row.label }}</span>
                <button class="cell bind" data-class-capturing="capturing == row.index * 10"
                        data-event-click="bind(0, row.index, 0)">{{ capturing == row.index * 10 ? prompt : row.first }}</button>
                <button class="cell clear" data-class-disabled="!row.clear_first" data-event-click="clear(0, row.index, 0)">&#215;</button>
                <button class="cell bind" data-class-capturing="capturing == row.index * 10 + 1"
                        data-event-click="bind(0, row.index, 1)">{{ capturing == row.index * 10 + 1 ? prompt : row.second }}</button>
                <button class="cell clear" data-class-disabled="!row.clear_second" data-event-click="clear(0, row.index, 1)">&#215;</button>
            </div>
            <div class="section">Menu</div>
            <div class="binding" data-for="row : menu_rows">
                <span class="name">{{ row.label }}</span>
                <button class="cell bind" data-class-capturing="capturing == 1000 + row.index * 10"
                        data-event-click="bind(1, row.index, 0)">{{ capturing == 1000 + row.index * 10 ? prompt : row.first }}</button>
                <button class="cell clear" data-class-reset="row.reset_first" data-class-disabled="!row.clear_first"
                        data-event-click="clear(1, row.index, 0)"><span class="icon" data-if="row.reset_first"></span>{{ row.reset_first ? '' : '&#215;' }}</button>
                <button class="cell bind" data-class-capturing="capturing == 1000 + row.index * 10 + 1"
                        data-event-click="bind(1, row.index, 1)">{{ capturing == 1000 + row.index * 10 + 1 ? prompt : row.second }}</button>
                <button class="cell clear" data-class-disabled="!row.clear_second" data-event-click="clear(1, row.index, 1)">&#215;</button>
            </div>
        </div>
        <div class="footer">
            <span class="note">Esc or Guide cancels rebinding</span>
            <button id="reset" class="action" data-event-click="reset_controls()">Reset {{ device == 'gamepad' ? 'gamepad' : 'keyboard/mouse' }} to defaults</button>
        </div>
    </div>

    <div class="page" data-if="tab == 'sound'">
        <div class="setting">
            <span class="name">Volume</span>
            <input type="range" min="0" max="100" step="5" data-value="volume"/>
            <span class="value">{{ volume }}%</span>
        </div>
        <div class="setting">
            <span class="name">Mute</span>
            <input type="checkbox" data-checked="muted"/>
        </div>
    </div>

    <div class="page" data-if="tab == 'general'">
        <div class="setting">
            <span class="name">60 FPS mode</span>
            <input type="checkbox" data-checked="fps60"/>
            <span class="note">Twice the frame rate; needs about twice the CPU</span>
        </div>
        <div class="setting">
            <span class="name">Rumble</span>
            <input type="range" min="0" max="100" step="10" data-value="rumble"/>
            <span class="value">{{ rumble == 0 ? 'Off' : rumble + '%' }}</span>
        </div>
        <div class="setting">
            <span class="name">Free stick direction</span>
            <input type="checkbox" data-checked="free_stick"/>
            <span class="note">Move in any direction at full tilt (the game snaps a nearly straight stick to straight)</span>
        </div>
        <div class="setting">
            <span class="name">Mouse aims pointer</span>
            <input type="checkbox" data-checked="mouse_pointer"/>
            <span class="note">Move the mouse over the window to aim the Wii Remote pointer</span>
        </div>
        <div class="setting">
            <span class="name">Wii Remote</span>
            <span class="status">{{ remote_status }}</span>
        </div>
        <div class="setting">
            <span class="name">Scan for Wii Remotes</span>
            <input type="checkbox" data-checked="wiimote_scan"/>
            <span class="note">Connects a Wii Remote when you press 1 and 2; may disturb other Bluetooth devices</span>
        </div>
        <div class="setting">
            <span class="name">Sensor bar above screen</span>
            <input type="checkbox" data-checked="sensor_bar_above"/>
            <span class="note">The Wii's "Sensor Bar Position" setting, for a real Wii Remote's pointer</span>
        </div>
        <div class="setting">
            <span class="name">Wii Remote speaker</span>
            <input type="checkbox" data-checked="wiimote_speaker"/>
            <span class="note">The game's Wii Remote sounds play on a connected remote's speaker</span>
        </div>
        <div class="setting">
            <span class="name">Remote sounds on PC</span>
            <input type="checkbox" data-checked="wiimote_sounds_pc"/>
            <span class="note">... and on the PC's speakers when no remote plays them</span>
        </div>
        <div class="setting">
            <span class="name">IR sensitivity</span>
            <input type="range" min="1" max="5" step="1" data-value="ir_sensitivity"/>
            <span class="value">{{ ir_sensitivity }}</span>
            <span class="note">The Wii's "Sensitivity" setting: the Wii Remote camera's gain (3 is the Wii's default)</span>
        </div>
        <div class="setting">
            <span class="name">Fullscreen</span>
            <input type="checkbox" data-checked="fullscreen"/>
            <span class="note">F11 or Alt+Enter</span>
        </div>
    </div>

    <div id="hints">
        <span>F5: pause game</span>
        <span>F11: fullscreen</span>
        <span>Menu buttons: Controls &#8250; Menu</span>
        <button class="action" data-event-click="close()">Back to game</button>
    </div>
</div>
</body>
</rml>
