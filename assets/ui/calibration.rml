<rml>
<head>
    <title>Pointer calibration</title>
    <link type="text/rcss" href="menu.rcss"/>
    <style>
        body { background-color: rgba(0, 0, 0, 170); }
        #modal {
            position: absolute;
            left: 50%;
            top: 50%;
            width: 720dp;
            margin-left: -360dp;
            margin-top: -330dp;
            padding: 18dp 22dp;
            box-sizing: border-box;
            border-radius: 14dp;
            background-color: rgb(20, 22, 30);
            border: 1dp rgba(255, 255, 255, 40);
        }
        .title { font-size: 19dp; font-weight: bold; color: #f3e3c3; margin-bottom: 12dp; }
        /* The IR camera's image (1024 x 768), as the remote sees the sensor bar */
        #camera {
            position: relative;
            width: 400dp;
            height: 300dp;
            margin: 0 auto;
            border-radius: 6dp;
            background-color: rgba(0, 0, 0, 160);
            border: 1dp rgba(255, 255, 255, 40);
        }
        /* Sizes and positions come from the data (SettingsMenu::set_ir_view); a large radius rounds
           any size into a circle. */
        .dot { position: absolute; border-radius: 200dp; }
        .dot.raw { background-color: rgba(200, 200, 210, 150); }
        .dot.merged { border: 2dp #8fc7ff; }
        .dot.end { border: 2dp #d6a95c; }
        .dot.radius { border: 1dp rgba(143, 199, 255, 120); }
        .legend { margin-top: 8dp; text-align: center; color: #8d897f; font-size: 13dp; }
        .key { display: inline-block; width: 10dp; height: 10dp; border-radius: 5dp; margin: 0 6dp 0 16dp; }
        .key.raw { background-color: rgba(200, 200, 210, 150); }
        .key.merged { border: 2dp #8fc7ff; }
        .key.end { border: 2dp #d6a95c; }
        .key.radius { border: 1dp rgba(143, 199, 255, 110); }
        .ir-status { margin: 6dp 0 8dp 0; text-align: center; color: #d6b37a; }
        .setting .name { width: 230dp; }
        input.range { width: 240dp; }
    </style>
</head>
<body data-model="settings">
<div id="modal">
    <div class="title">Wii Remote pointer</div>
    <div id="camera">
        <div class="dot" data-for="dot : ir_dots" data-class-raw="dot.kind == 'raw'" data-class-merged="dot.kind == 'merged'"
             data-class-end="dot.kind == 'end'" data-class-radius="dot.kind == 'radius'" data-style-left="dot.left"
             data-style-top="dot.top" data-style-width="dot.size" data-style-height="dot.size"
             data-style-margin-left="dot.offset" data-style-margin-top="dot.offset"></div>
    </div>
    <div class="legend"><span class="key raw"></span>dots seen<span class="key merged"></span>after merging<span class="key end"></span>bar ends tracked<span class="key radius"></span>merge distance</div>
    <div class="ir-status">{{ ir_status }}</div>

    <div class="setting">
        <span class="name">Merge nearby dots</span>
        <input id="calibration-merge" type="range" min="0" max="200" step="5" data-value="ir_merge"/>
        <span class="value">{{ ir_merge == 0 ? 'Off' : ir_merge + ' px' }}</span>
    </div>
    <div class="setting">
        <span class="name">Sensor bar position</span>
        <input type="range" min="-50" max="50" step="1" data-value="sensor_bar_offset"/>
        <span class="value wide">{{ sensor_bar_label }}</span>
    </div>
    <div class="setting">
        <span class="name">IR sensitivity</span>
        <input type="range" min="1" max="5" step="1" data-value="ir_sensitivity"/>
        <span class="value">{{ ir_sensitivity }}</span>
    </div>
    <div class="footer">
        <span class="note">A sensor bar end is a group of LEDs: if one shows as several dots, raise merging until it shows as one</span>
        <button id="calibration-done" class="action" data-event-click="close_calibration()">Done</button>
    </div>
</div>
</body>
</rml>
