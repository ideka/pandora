<rml>
<head>
    <title>Paused</title>
    <style>
        body { width: 100%; height: 100%; font-family: LatoLatin; pointer-events: none; }
        #badge {
            display: block;
            position: absolute;
            right: 24dp;
            top: 20dp;
            padding: 8dp 16dp;
            border-radius: 8dp;
            background-color: rgba(16, 18, 26, 200);
            border: 1dp rgba(255, 255, 255, 40);
            color: #f3e3c3;
            font-size: 18dp;
            font-weight: bold;
        }
        #badge span { font-weight: normal; color: #a9a59c; font-size: 15dp; }
    </style>
</head>
<body>
    <div id="badge">Paused <span>&#8212; F5 to resume</span></div>
</body>
</rml>
