+          "        let nrm_len_sq = dot(in.mv_nrm, in.mv_nrm);\n"
+          "        let unit_nrm = select(vec3f(0.0), normalize(in.mv_nrm), nrm_len_sq > 1e-10);\n"
+          "        out.normal = vec4f(unit_nrm * 0.5 + 0.5, select(0.0, 1.0, nrm_len_sq > 1e-10));\n"
+          "    } else {\n"
+          "        out.normal = vec4f(0.5, 0.5, 0.5, 0.0);\n"
+          "    }\n"
+          "    return out;";
+  }
+  if (dstAlphaMode == DstAlphaMode::DualSource) {
+    output = "struct FragmentOutput {\n"
+             "    @location(0) @blend_src(0) color: vec4f,\n"
+             "    @location(0) @blend_src(1) blend: vec4f,\n"
+             "};\n";
+    outputType = "FragmentOutput";
+    ret = "    return FragmentOutput(vec4f(prev.rgb, 1.0), prev);";
+  }
+  replace_all(src, "@@FRAGMENT_OUTPUT_TYPE@@", outputType);
+  replace_all(src, "@@FRAGMENT_OUTPUT@@", output);
+  replace_all(src, "@@FRAGMENT_RETURN@@", ret);
+  return src;
+}
+
+u32 null4(u32 v) { return v == 0xFF ? 15u : v & 15u; }
+} // namespace
+
+UberShaderMode uber_shader_mode() noexcept { return sMode.load(std::memory_order_relaxed); }
+void set_uber_shader_mode(UberShaderMode mode) noexcept { sMode.store(mode, std::memory_order_relaxed); }
+
+PipelineConfig make_uber_pipeline_config(const PipelineConfig& config) noexcept {
+  PipelineConfig uber = config;
+  uber.shaderConfig = {};
+  uber.shaderConfig.lineMode = config.shaderConfig.lineMode;
+  uber.shaderConfig.pad2 = UberShaderMarker;
+  return uber;
+}
+
+wgpu::ShaderModule build_uber_shader(u8 lineMode, const gfx::RenderTargetLayout& layout,
+                                     DstAlphaMode dstAlphaMode) noexcept {
+  ZoneScoped;
+  uint32_t normalAttachment = UINT32_MAX;
+  for (uint32_t i = 0; i < layout.colorAttachmentCount; ++i) {
+    if (layout.colorAttachments[i].semantic == gfx::ColorAttachmentSemantic::Normal) {
+      normalAttachment = i;
+    }
+  }
+  static std::mutex mutex;
+  static absl::flat_hash_map<u64, wgpu::ShaderModule> modules;
+  const u64 key = u64{lineMode} | u64{normalAttachment & 0xFFu} << 8 | u64{underlying(dstAlphaMode)} << 16;
+  std::lock_guard lock{mutex};
+  if (const auto it = modules.find(key); it != modules.end()) {
+    return it->second;
+  }
+  const auto source = uber_shader_source(lineMode, normalAttachment, dstAlphaMode);
+  wgpu::ShaderSourceWGSL wgsl{};
+  wgsl.code = source.c_str();
+  const auto label = fmt::format("GX Ubershader {:x}", key);
+  const wgpu::ShaderModuleDescriptor descriptor{
+      .nextInChain = &wgsl,
+      .label = label.c_str(),
+  };
+  auto module = webgpu::g_device.CreateShaderModule(&descriptor);
+  modules.emplace(key, module);
+  Log.info("Built ubershader module {:x}", key);
+  return module;
+}
+
+gfx::Range push_uber_config(const ShaderConfig& config, const ShaderInfo& info) noexcept {
+  ZoneScoped;
+  std::array<u32, CfgWords> w{};
+  const auto& nrm = config.attrs[GX_VA_NRM];
+  w[CfgHeader] = (config.tevStageCount & 31u) | (config.numIndStages & 7u) << 5 | (config.fogType & 31u) << 8 |
+                 u32{config.fogRangeEnabled} << 13 | u32{config.lineMode} << 14 | u32{config.vtxStride} << 16 |
+                 u32{nrm.attrType != GX_NONE} << 24 | u32{nrm.nbt3} << 25;
+  const auto& ac = config.alphaCompare;
+  w[CfgAlphaCmp] = (ac.comp0 & 7u) | (ac.op & 3u) << 3 | (ac.comp1 & 7u) << 5 | u32{static_cast<bool>(ac)} << 8 |
+                   (ac.ref0 & 0xFFu) << 16 | (ac.ref1 & 0xFFu) << 24;
+  w[CfgMasks] = static_cast<u32>(info.sampledTexCoords.to_ulong()) |
+                static_cast<u32>(info.sampledColorChannels.to_ulong()) << 8 |
+                static_cast<u32>(info.usedIndStages.to_ulong()) << 10 |
+                static_cast<u32>(info.loadsTevReg.to_ulong()) << 14;
+  for (u32 t = 0; t < MaxTevSwap; ++t) {
+    const auto& swap = config.tevSwapTable[t];
+    w[CfgSwap] |= (swap.red & 3u) << (t * 8) | (swap.green & 3u) << (t * 8 + 2) | (swap.blue & 3u) << (t * 8 + 4) |
+                  (swap.alpha & 3u) << (t * 8 + 6);
+  }
+  for (u32 c = 0; c < MaxColorChannels; ++c) {
+    const auto& ch = config.colorChannels[c];
+    w[CfgChannels] |= ((ch.matSrc & 1u) | (ch.ambSrc & 1u) << 1 | (ch.diffFn & 3u) << 2 | (ch.attnFn & 3u) << 4 |
+                       u32{ch.lightingEnabled} << 6)
+                      << (c * 8);
+  }
+  for (u32 i = 0; i < MaxTexCoord; ++i) {
+    const auto& tcg = config.tcgs[i];
+    w[CfgTcg + i] = (tcg.type & 15u) | (tcg.src & 31u) << 4 | (tcg.mtx & 127u) << 9 | (tcg.postMtx & 127u) << 16 |
+                    u32{tcg.normalize} << 23 | (tcg.embossSrc & 7u) << 24;
+  }
+  for (u32 i = 0; i < MaxIndStages; ++i) {
+    const auto& s = config.indStages[i];
+    w[CfgIndStages + i / 2] |=
+        (null4(s.texCoordId) | null4(s.texMapId) << 4 | (s.scaleS & 15u) << 8 | (s.scaleT & 15u) << 12) << (i % 2 * 16);
+  }
+  for (u32 a = 0; a <= GX_VA_TEX7; ++a) {
+    const auto& m = config.attrs[a];
+    w[CfgAttrs + a] = (m.attrType & 3u) | (m.cnt & 15u) << 2 | (m.compType & 15u) << 6 | u32{m.offset} << 10 |
+                      u32{m.stride} << 18 | (m.frac & 31u) << 26 | u32{m.le} << 31;
+  }
+  for (u32 s = 0; s < config.tevStageCount && s < MaxTevStages; ++s) {
+    const auto& st = config.tevStages[s];
+    const auto usesSample = [&] {
+      if (st.texMapId == GX_TEXMAP_NULL) {
+        return false;
+      }
+      const auto& c = st.colorPass;
+      const auto& a = st.alphaPass;
+      return c.a == GX_CC_TEXC || c.a == GX_CC_TEXA || c.b == GX_CC_TEXC || c.b == GX_CC_TEXA ||
+             c.c == GX_CC_TEXC || c.c == GX_CC_TEXA || c.d == GX_CC_TEXC || c.d == GX_CC_TEXA ||
+             a.a == GX_CA_TEXA || a.b == GX_CA_TEXA || a.c == GX_CA_TEXA || a.d == GX_CA_TEXA;
+    }();
+    auto& base = *reinterpret_cast<std::array<u32, 4>*>(&w[CfgTev + s * 4]);
+    base[0] = (st.colorPass.a & 15u) | (st.colorPass.b & 15u) << 4 | (st.colorPass.c & 15u) << 8 |
+              (st.colorPass.d & 15u) << 12 | (st.alphaPass.a & 7u) << 16 | (st.alphaPass.b & 7u) << 19 |
+              (st.alphaPass.c & 7u) << 22 | (st.alphaPass.d & 7u) << 25;
+    base[1] = (st.colorOp.op & 15u) | (st.colorOp.bias & 3u) << 4 | (st.colorOp.scale & 3u) << 6 |
+              (st.colorOp.outReg & 3u) << 8 | u32{st.colorOp.clamp} << 10 | (st.alphaOp.op & 15u) << 11 |
+              (st.alphaOp.bias & 3u) << 15 | (st.alphaOp.scale & 3u) << 17 | (st.alphaOp.outReg & 3u) << 19 |
+              u32{st.alphaOp.clamp} << 21 | (st.kcSel & 31u) << 22 | (st.kaSel & 31u) << 27;
+    base[2] = null4(st.texCoordId) | null4(st.texMapId) << 4 | null4(st.channelId) << 8 | (st.tevSwapRas & 3u) << 12 |
+              (st.tevSwapTex & 3u) << 14 | (st.indTexStage & 3u) << 16 | (st.indTexFormat & 3u) << 18 |
+              (st.indTexBiasSel & 7u) << 20 | (st.indTexAlphaSel & 3u) << 23 | (st.indTexMtxId & 15u) << 25;
+    base[3] = (st.indTexWrapS & 7u) | (st.indTexWrapT & 7u) << 3 | u32{st.indTexUseOrigLOD} << 6 |
+              u32{st.indTexAddPrev} << 7 | u32{usesSample} << 8;
+  }
+  return gfx::push_storage(reinterpret_cast<const uint8_t*>(w.data()), sizeof(w));
+}
+
+} // namespace aurora::gx
+
+void aurora_set_ubershader_mode(int mode) {
+  aurora::gx::set_uber_shader_mode(mode <= 0   ? aurora::gx::UberShaderMode::Off
+                                   : mode == 1 ? aurora::gx::UberShaderMode::Fallback
+                                               : aurora::gx::UberShaderMode::Force);
+}
