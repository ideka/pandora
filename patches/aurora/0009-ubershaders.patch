+            let has_base_coord = tex_coord_id != 15u && has_base_tex;
+            // The stage's texcoord, perspective-divided for GX_TG_MTX3x4 (flag from pack_uber_config)
+            let uvw = pick8(tex_coord_id & 7u, vec4f(in.tex0, 0.0), vec4f(in.tex1, 0.0), vec4f(in.tex2, 0.0),
+                            vec4f(in.tex3, 0.0), vec4f(in.tex4, 0.0), vec4f(in.tex5, 0.0), vec4f(in.tex6, 0.0),
+                            vec4f(in.tex7, 0.0)).xyz;
+            let base_uv = select(uvw.xy, uvw.xy / uvw.z, bits(st.d, 20u, 1u) != 0u);
+            var uv_in = base_uv;
+            if (needs_tev_coord) {
