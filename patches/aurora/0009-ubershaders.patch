+
+// --- Config --------------------------------------------------------------------------------
+
+fn cfg(i: u32) -> u32 {
+    return ubuf.cfg[i / 4u][i % 4u];
+}
+fn bits(v: u32, shift: u32, count: u32) -> u32 {
+    return extractBits(v, shift, count);
+}
+fn tev_stage_count() -> u32 { return bits(cfg(0u), 0u, 5u); }
+fn num_ind_stages() -> u32 { return bits(cfg(0u), 5u, 3u); }
+fn fog_type() -> u32 { return bits(cfg(0u), 8u, 5u); }
+fn fog_range_enabled() -> bool { return bits(cfg(0u), 13u, 1u) != 0u; }
+fn vtx_stride() -> u32 { return bits(cfg(0u), 16u, 8u); }
+fn has_normal() -> bool { return bits(cfg(0u), 24u, 1u) != 0u; }
+fn nrm_nbt3() -> bool { return bits(cfg(0u), 25u, 1u) != 0u; }
+fn sampled_texcoords() -> u32 { return bits(cfg(2u), 0u, 8u); }
+fn sampled_channels() -> u32 { return bits(cfg(2u), 8u, 2u); }
+fn used_ind_stages() -> u32 { return bits(cfg(2u), 10u, 4u); }
+fn loads_tev_reg() -> u32 { return bits(cfg(2u), 14u, 4u); }
+fn swap_sel(table: u32, chan: u32) -> u32 { return bits(cfg(3u), table * 8u + chan * 2u, 2u); }
+fn channel(i: u32) -> u32 { return bits(cfg(4u), i * 8u, 8u); }
+fn tcg(i: u32) -> u32 { return cfg(5u + i); }
+fn ind_stage(i: u32) -> u32 { return bits(cfg(13u + i / 2u), (i % 2u) * 16u, 16u); }
+fn attr_word(attr: u32) -> u32 { return cfg(15u + attr); }
+fn attr_type(attr: u32) -> u32 { return attr_word(attr) & 3u; }
+
+// --- Buffer loads (vbuf: vertices, abuf: arrays) ---------------------------------------------
+
+fn load_word(from_abuf: bool, word_idx: u32) -> u32 {
+    if (from_abuf) {
+        if (word_idx < arrayLength(&abuf)) {
+            return abuf[word_idx];
+        }
+        return 0u;
+    }
+    if (word_idx < arrayLength(&vbuf)) {
+        return vbuf[word_idx];
+    }
+    return 0u;
+}
+fn bswap32(v: u32, le: bool) -> u32 {
+    if (le) {
+        return v;
+    }
+    return ((v & 0x000000FFu) << 24u) | ((v & 0x0000FF00u) << 8u) | ((v & 0x00FF0000u) >> 8u) |
+           ((v & 0xFF000000u) >> 24u);
+}
+fn bswap16(v: u32, le: bool) -> u32 {
+    return select(((v & 0xFFu) << 8u) | (v >> 8u), v, le);
+}
+fn load_u8(a: bool, byte_off: u32) -> u32 {
+    let word = load_word(a, byte_off / 4u);
+    return (word >> ((byte_off & 3u) * 8u)) & 0xFFu;
+}
+fn load_u32_raw(a: bool, byte_off: u32) -> u32 {
+    let word_idx = byte_off >> 2u;
+    let sub = byte_off & 3u;
+    let lo = load_word(a, word_idx);
+    if (sub == 0u) {
+        return lo;
+    }
+    let hi = load_word(a, word_idx + 1u);
+    let shift = sub * 8u;
+    return (lo >> shift) | (hi << (32u - shift));
+}
+fn load_u16(a: bool, byte_off: u32, le: bool) -> u32 {
+    let word_idx = byte_off >> 2u;
+    let sub = byte_off & 3u;
+    let word = load_word(a, word_idx);
+    if (sub <= 2u) {
+        return bswap16(extractBits(word, sub * 8u, 16u), le);
+    }
+    let next = load_word(a, word_idx + 1u);
+    let raw = extractBits(word, 24u, 8u) | (extractBits(next, 0u, 8u) << 8u);
+    return bswap16(raw, le);
+}
+fn load_u24(a: bool, byte_off: u32, le: bool) -> u32 {
+    let raw = load_u32_raw(a, byte_off) & 0x00FFFFFFu;
+    if (le) {
+        return raw;
+    }
+    return ((raw & 0x0000FFu) << 16u) | (raw & 0x00FF00u) | ((raw & 0xFF0000u) >> 16u);
+}
+
+// --- Vertex attributes ---------------------------------------------------------------------
+
+struct AttrAddress {
+    offs: u32,
+    from_abuf: bool,
+    le: bool,
+};
+
+fn array_start(attr: u32) -> u32 {
+    let i = attr - 9u;
+    var v = imm.array_start2;
+    if (i < 4u) {
+        v = imm.array_start0;
+    } else if (i < 8u) {
+        v = imm.array_start1;
+    }
+    return v[i % 4u];
+}
+
+fn attr_address(attr: u32, vidx: u32, dl_extra: u32, within: u32) -> AttrAddress {
+    let w = attr_word(attr);
+    let ty = w & 3u;
+    let dl = bits(w, 10u, 8u) + dl_extra;
+    let stride = bits(w, 18u, 8u);
+    let le = bits(w, 31u, 1u) != 0u;
+    let vtx = imm.vtx_start + vidx * vtx_stride() + dl;
+    if (ty == 2u) {
+        return AttrAddress(array_start(attr) + load_u8(false, vtx) * stride + within, true, le);
+    }
+    if (ty == 3u) {
+        return AttrAddress(array_start(attr) + load_u16(false, vtx, false) * stride + within, true, le);
+    }
+    return AttrAddress(vtx + within, false, false);
+}
+
+fn comp_size(comp: u32) -> u32 {
+    switch (comp) {
+        case 0u, 1u: { return 1u; }
+        case 2u, 3u: { return 2u; }
+        default: { return 4u; }
+    }
+}
+
+fn fetch_comp(a: bool, off: u32, comp: u32, frac: u32, le: bool) -> f32 {
+    let div = f32(1u << frac);
+    switch (comp) {
+        case 0u: { return f32(load_u8(a, off)) / div; }
+        case 1u: { return f32((bitcast<i32>(load_u8(a, off)) << 24u) >> 24u) / div; }
+        case 2u: { return f32(load_u16(a, off, le)) / div; }
+        case 3u: { return f32(bitcast<i32>(load_u16(a, off, le) << 16u) >> 16u) / div; }
+        default: { return bitcast<f32>(bswap32(load_u32_raw(a, off), le)); }
+    }
+}
+
+// An attribute's components (count from the config, or `count` if nonzero), zero beyond them.
+fn fetch_attr(attr: u32, vidx: u32, count: u32, dl_extra: u32, within: u32) -> vec4f {
+    let w = attr_word(attr);
+    let comp = bits(w, 6u, 4u);
+    let frac = bits(w, 26u, 5u);
+    var cnt = bits(w, 2u, 4u);
+    if (count != 0u) {
+        cnt = count;
+    }
+    let ad = attr_address(attr, vidx, dl_extra, within);
+    if (comp == 5u) {
+        return unpack4x8unorm(load_u32_raw(ad.from_abuf, ad.offs));
+    }
+    let size = comp_size(comp);
+    var r = vec4f(0.0);
+    for (var k = 0u; k < min(cnt, 4u); k++) {
+        r[k] = fetch_comp(ad.from_abuf, ad.offs + k * size, comp, frac, ad.le);
+    }
+    return r;
+}
+
+fn fetch_color(attr: u32, vidx: u32) -> vec4f {
+    let comp = bits(attr_word(attr), 6u, 4u);
+    let ad = attr_address(attr, vidx, 0u, 0u);
+    let a = ad.from_abuf;
+    switch (comp) {
+        case 0u: {
+            let v = load_u16(a, ad.offs, ad.le);
+            return vec4f(f32((v >> 11u) & 0x1Fu) / f32(0x1Fu), f32((v >> 5u) & 0x3Fu) / f32(0x3Fu),
+                         f32((v >> 0u) & 0x1Fu) / f32(0x1Fu), 1.0);
+        }
+        case 1u, 2u: {
+            let raw = load_u32_raw(a, ad.offs);
+            return vec4f(f32(extractBits(raw, 0u, 8u)), f32(extractBits(raw, 8u, 8u)), f32(extractBits(raw, 16u, 8u)),
+                         255.0) / 255.0;
+        }
+        case 3u: {
+            let v = load_u16(a, ad.offs, ad.le);
+            return vec4f(f32((v >> 12u) & 0x0Fu) / f32(0x0Fu), f32((v >> 8u) & 0x0Fu) / f32(0x0Fu),
+                         f32((v >> 4u) & 0x0Fu) / f32(0x0Fu), f32((v >> 0u) & 0x0Fu) / f32(0x0Fu));
+        }
+        case 4u: {
+            let v = load_u24(a, ad.offs, ad.le);
+            return vec4f(f32((v >> 18u) & 0x3Fu) / f32(0x3Fu), f32((v >> 12u) & 0x3Fu) / f32(0x3Fu),
+                         f32((v >> 6u) & 0x3Fu) / f32(0x3Fu), f32((v >> 0u) & 0x3Fu) / f32(0x3Fu));
+        }
+        default: {
+            let raw = load_u32_raw(a, ad.offs);
+            return vec4f(f32(extractBits(raw, 0u, 8u)), f32(extractBits(raw, 8u, 8u)), f32(extractBits(raw, 16u, 8u)),
+                         f32(extractBits(raw, 24u, 8u))) / 255.0;
+        }
+    }
+}
+
+fn load_pnmtxidx(vidx: u32) -> u32 {
+    if (attr_type(0u) == 0u) {
+        return imm.current_pnmtx;
+    }
+    let ad = attr_address(0u, vidx, 0u, 0u);
+    return load_u8(ad.from_abuf, ad.offs) / 3u;
+}
+fn load_texmtxidx(i: u32, vidx: u32) -> u32 {
+    let ad = attr_address(1u + i, vidx, 0u, 0u);
+    return load_u8(ad.from_abuf, ad.offs);
+}
+fn load_pos(vidx: u32) -> vec3f {
+    return fetch_attr(9u, vidx, 0u, 0u, 0u).xyz;
+}
+fn load_nrm(vidx: u32) -> vec3f {
+    if (attr_type(10u) == 0u) {
+        return vec3f(1.0, 0.0, 0.0);
+    }
+    return fetch_attr(10u, vidx, min(bits(attr_word(10u), 2u, 4u), 3u), 0u, 0u).xyz;
+}
+// Binormal (slice 1) or tangent (slice 2) of an NBT normal.
+fn load_nbt(slice: u32, vidx: u32) -> vec3f {
+    let w = attr_word(10u);
+    let ty = w & 3u;
+    if (ty == 0u || bits(w, 2u, 4u) != 9u) {
+        return vec3f(0.0);
+    }
+    var dl_extra = 0u;
+    if (nrm_nbt3()) {
+        if (ty == 2u) {
+            dl_extra = slice;
+        } else if (ty == 3u) {
+            dl_extra = slice * 2u;
+        }
+    }
+    let size = comp_size(bits(w, 6u, 4u));
+    return fetch_attr(10u, vidx, 3u, dl_extra, slice * 3u * size).xyz;
+}
+fn load_clr(i: u32, vidx: u32) -> vec4f {
+    if (attr_type(11u + i) == 0u) {
+        return vec4f(0.0);
+    }
+    return fetch_color(11u + i, vidx);
+}
+fn load_tex(i: u32, vidx: u32) -> vec2f {
+    return fetch_attr(13u + i, vidx, 0u, 0u, 0u).xy;
+}
+
+// --- Vertex stage --------------------------------------------------------------------------
+
+struct VertexOutput {
+    @builtin(position) pos: vec4f,
+    @location(0) cc0: vec4f,
+    @location(1) cc1: vec4f,
+    @location(2) mv_nrm: vec3f,
+    @location(3) tex0: vec3f,
+    @location(4) tex1: vec3f,
+    @location(5) tex2: vec3f,
+    @location(6) tex3: vec3f,
+    @location(7) tex4: vec3f,
+    @location(8) tex5: vec3f,
+    @location(9) tex6: vec3f,
+    @location(10) tex7: vec3f,
+};
+
+// One color channel (i: 0 or 1; alpha: its alpha half), as lighting_func in shader.cpp.
+fn light_channel(i: u32, alpha: bool, mv_pos: vec3f, mv_nrm: vec3f, clr: vec4f) -> vec4f {
+    let ch = i + select(0u, 2u, alpha);
+    let c = channel(ch);
+    let mat = select(ubuf.cc_mat[ch], clr, bits(c, 0u, 1u) != 0u);
+    if (bits(c, 6u, 1u) == 0u) {
+        return mat;
+    }
+    let amb = select(ubuf.cc_amb[ch], clr, bits(c, 1u, 1u) != 0u);
+    let diff_fn = bits(c, 2u, 2u);
+    let attn_fn = bits(c, 4u, 2u);
+    var lighting = amb;
+    // Run-time bounds (the highest light in the mask) keep the compiler from unrolling the loop.
+    let light_mask = ubuf.light_state[ch] & 0xFFu;
+    let light_count = 32u - countLeadingZeros(light_mask);
+    for (var l = 0u; l < light_count; l++) {
+        if ((light_mask & (1u << l)) == 0u) { continue; }
+        let light = ubuf.lights[l];
+        var ldir = light.pos - mv_pos;
+        let dist2 = dot(ldir, ldir);
+        let dist = sqrt(dist2);
+        ldir = ldir / dist;
+        var attn: f32;
+        if (attn_fn == 2u) {
+            attn = 1.0;
+        } else if (attn_fn == 1u) {
+            let cosine = max(0.0, dot(ldir, light.dir));
+            let cos_attn = dot(light.cos_att, vec3f(1.0, cosine, cosine * cosine));
+            let dist_attn = dot(light.dist_att, vec3f(1.0, dist, dist2));
+            attn = max(0.0, cos_attn / dist_attn);
+        } else {
+            attn = select(0.0, max(0.0, dot(mv_nrm, light.dir)), dot(mv_nrm, ldir) >= 0.0);
+            let cos_attn = dot(light.cos_att, vec3f(1.0, attn, attn * attn));
+            var dist_attn: f32;
+            if (diff_fn != 0u) {
+                dist_attn = max(0.0, dot(normalize(light.dist_att), vec3f(1.0, attn, attn * attn)));
+            } else {
+                dist_attn = max(0.0, dot(light.dist_att, vec3f(1.0, attn, attn * attn)));
+            }
+            attn = max(0.0, cos_attn / dist_attn);
+        }
+        var diff = 1.0;
+        if (diff_fn == 1u) {
+            diff = dot(ldir, mv_nrm);
+        } else if (diff_fn == 2u) {
+            diff = max(0.0, dot(ldir, mv_nrm));
+        }
+        lighting = lighting + (attn * diff * light.color);
+    }
+    return mat * clamp(lighting, vec4f(0.0), vec4f(1.0));
+}
+
+// Texture coordinate generation, per texcoord (no arrays indexed at run time: they would live in
+// local memory). A TEXCOORDn source is texgen n's own source, as in shader.cpp.
+struct TexgenInput {
+    in_vidx: u32,
+    vidx: u32,
+    pnmtxidx: u32,
+    pos: vec3f,
+    nrm: vec3f,
+    binrm: vec3f,
+    tangent: vec3f,
+    cc0: vec4f,
+    cc1: vec4f,
+    mv_pos: vec3f,
+};
+
+fn texgen_direct_source(i: u32, v: TexgenInput) -> vec4f {
+    let src = bits(tcg(i), 4u, 5u);
+    if (src >= 4u && src <= 11u) {
+        return vec4f(load_tex(src - 4u, v.in_vidx), 1.0, 1.0);
+    }
+    switch (src) {
+        case 0u: { return vec4f(v.pos, 1.0); }
+        case 1u: { return vec4f(v.nrm, 1.0); }
+        case 2u: { return vec4f(v.binrm, 1.0); }
+        case 3u: { return vec4f(v.tangent, 1.0); }
+        case 19u: { return v.cc0; }
+        case 20u: { return v.cc1; }
+        default: { return vec4f(0.0); }
+    }
+}
+fn texgen_source(i: u32, v: TexgenInput) -> vec4f {
+    let src = bits(tcg(i), 4u, 5u);
+    return texgen_direct_source(select(i, src - 12u, src >= 12u && src <= 18u), v);
+}
+
+// A (non-emboss) texgen's projected coordinate.
+fn texgen_proj(i: u32, v: TexgenInput) -> vec3f {
+    let g = tcg(i);
+    let ty = bits(g, 0u, 4u);
+    let mtx = bits(g, 9u, 7u);
+    let post = bits(g, 16u, 7u);
+    let tc = texgen_source(i, v);
+    var tmp: vec3f;
+    if (ty <= 1u) {
+        if (attr_type(1u + i) != 0u) {
+            tmp = tc * ubuf.postex_mtx[load_texmtxidx(i, v.in_vidx) / 3u];
+        } else if (mtx == 60u) {
+            tmp = tc.xyz;
+        } else {
+            tmp = tc * ubuf.postex_mtx[mtx / 3u];
+        }
+        if (ty == 1u) {
+            tmp.z = 1.0;
+        }
+    } else {
+        tmp = vec3f(tc.xy, 1.0);
+    }
+    if (bits(g, 23u, 1u) != 0u) {
+        tmp = normalize(tmp);
+    }
+    var proj = tmp;
+    if (post != 125u) {
+        proj = vec4f(tmp.xyz, 1.0) * ubuf.postmtx[(post - 64u) / 3u];
+    }
+    if (LINE_MODE == 3u) {
+        if ((ubuf.line_texcoord_mask & (1u << i)) != 0u) {
+            if ((v.vidx & 1u) != 0u) { proj.x += ubuf.line_tex_offset; }
+            if (v.vidx >= 2u) { proj.y += ubuf.line_tex_offset; }
+        }
+    } else if (LINE_MODE != 0u) {
+        if ((ubuf.line_texcoord_mask & (1u << i)) != 0u && (v.vidx & 1u) != 0u) {
+            proj.y += ubuf.line_tex_offset;
+        }
+    }
+    return proj;
+}
+
+// A texgen's output (uvw for GX_TG_MTX3x4, uv and 1 otherwise).
+fn texgen(i: u32, v: TexgenInput) -> vec3f {
+    let g = tcg(i);
+    let ty = bits(g, 0u, 4u);
+    let emboss = ty >= 2u && ty <= 9u;
+    // Emboss bump: the source texcoord, offset by the light projected onto tangent/binormal
+    let proj = texgen_proj(select(i, bits(g, 24u, 3u), emboss), v);
+    if (emboss) {
+        let bump_ldir = normalize(ubuf.lights[ty - 2u].pos - v.mv_pos);
+        let bump_tan = vec4f(v.tangent, 0.0) * ubuf.nrm_mtx[v.pnmtxidx];
+        let bump_bin = vec4f(v.binrm, 0.0) * ubuf.nrm_mtx[v.pnmtxidx];
+        return vec3f(proj.xy + vec2f(dot(bump_ldir, bump_tan), dot(bump_ldir, bump_bin)), 1.0);
+    }
+    return select(vec3f(proj.xy, 1.0), proj, ty == 0u);
+}
+
+@vertex
+fn vs_main(
+    @builtin(vertex_index) vidx: u32@@IIDX@@
+) -> VertexOutput {
+    var out: VertexOutput;
+    var in_vidx = vidx;
+    var in_pos: vec3f;
+    var in_pnmtxidx: u32;
+    var mv_pos: vec3f;
+    var mv_pos_a: vec3f;
+    var mv_pos_b: vec3f;
+    var use_b = false;
+    if (LINE_MODE == 3u) {
+        in_vidx = iidx;
+        in_pos = load_pos(in_vidx);
+        in_pnmtxidx = load_pnmtxidx(in_vidx);
+        mv_pos = vec4f(in_pos, 1.0) * ubuf.postex_mtx[in_pnmtxidx];
+    } else if (LINE_MODE != 0u) {
+        use_b = vidx >= 2u;
+        let vidx_a = iidx * select(1u, 2u, LINE_MODE == 1u);
+        let vidx_b = vidx_a + 1u;
+        in_vidx = select(vidx_a, vidx_b, use_b);
+        let pos_a = load_pos(vidx_a);
+        let pos_b = load_pos(vidx_b);
+        in_pos = select(pos_a, pos_b, use_b);
+        let pnmtxidx_a = load_pnmtxidx(vidx_a);
+        let pnmtxidx_b = load_pnmtxidx(vidx_b);
+        in_pnmtxidx = select(pnmtxidx_a, pnmtxidx_b, use_b);
+        mv_pos_a = vec4f(pos_a, 1.0) * ubuf.postex_mtx[pnmtxidx_a];
+        mv_pos_b = vec4f(pos_b, 1.0) * ubuf.postex_mtx[pnmtxidx_b];
+        mv_pos = select(mv_pos_a, mv_pos_b, use_b);
+    } else {
+        in_pnmtxidx = load_pnmtxidx(vidx);
+        in_pos = load_pos(vidx);
+        mv_pos = vec4f(in_pos, 1.0) * ubuf.postex_mtx[in_pnmtxidx];
+    }
+    let in_nrm = load_nrm(in_vidx);
+
+    if (LINE_MODE == 0u) {
+        let clip_pos = vec4f(mv_pos, 1.0) * ubuf.proj;
+        let edge_ndc = clip_pos.xy / clip_pos.w;
+        let half_px_ndc = 1.0 / max(ubuf.logical_viewport_size, vec2f(1.0));
+        let near_edge = (abs(abs(edge_ndc) - 1.0) < half_px_ndc) & vec2<bool>(clip_pos.w > 0.0);
+        out.pos = vec4f(select(edge_ndc, sign(edge_ndc), near_edge) * clip_pos.w, clip_pos.zw);
+    } else if (LINE_MODE == 3u) {
+        let clip = vec4f(mv_pos, 1.0) * ubuf.proj;
+        let viewport_scale = ubuf.render_viewport_size / max(ubuf.logical_viewport_size, vec2f(1.0));
+        let point_size = ubuf.line_width * min(viewport_scale.x, viewport_scale.y);
+        let x_sign = select(-1.0, 1.0, (vidx & 1u) != 0u);
+        let y_sign = select(-1.0, 1.0, vidx >= 2u);
+        let offset_px = vec2f(x_sign, y_sign) * (point_size / 2.0);
+        let offset_ndc = (offset_px * 2.0) / ubuf.render_viewport_size;
+        out.pos = vec4f(clip.xy + offset_ndc * clip.w, clip.zw);
+    } else {
+        let clip_a = vec4f(mv_pos_a, 1.0) * ubuf.proj;
+        let clip_b = vec4f(mv_pos_b, 1.0) * ubuf.proj;
+        let ndc_a = clip_a.xy / clip_a.w;
+        let ndc_b = clip_b.xy / clip_b.w;
+        let viewport_scale = ubuf.render_viewport_size / max(ubuf.logical_viewport_size, vec2f(1.0));
+        let delta_px = (ndc_b - ndc_a) / 2.0 * ubuf.render_viewport_size;
+        let dir_px = select(vec2f(1.0, 0.0), normalize(delta_px), dot(delta_px, delta_px) > 1e-10);
+        let perp_px = vec2f(-dir_px.y, dir_px.x);
+        let line_width = ubuf.line_width * min(viewport_scale.x, viewport_scale.y);
+        let offset_px = perp_px * (line_width / 2.0) * select(-1.0, 1.0, (vidx & 1u) != 0u);
+        let offset_ndc = (offset_px * 2.0) / ubuf.render_viewport_size;
+        let clip_base = select(clip_a, clip_b, use_b);
+        out.pos = vec4f(clip_base.xy + offset_ndc * clip_base.w, clip_base.zw);
+    }
+    let nrm_tmp = vec4f(in_nrm, 0.0) * ubuf.nrm_mtx[in_pnmtxidx];
+    let mv_nrm = select(nrm_tmp, normalize(nrm_tmp), dot(nrm_tmp, nrm_tmp) > 1e-10);
+    out.mv_nrm = mv_nrm;
+
+    // Color channels
+    var cc0 = vec4f(0.0);
+    var cc1 = vec4f(0.0);
+    let channels = sampled_channels();
+    if ((channels & 1u) != 0u) {
+        let clr = load_clr(0u, in_vidx);
+        cc0 = light_channel(0u, false, mv_pos, mv_nrm, clr);
+        cc0.a = light_channel(0u, true, mv_pos, mv_nrm, clr).a;
+    }
+    if ((channels & 2u) != 0u) {
+        let clr = load_clr(1u, in_vidx);
+        cc1 = light_channel(1u, false, mv_pos, mv_nrm, clr);
+        cc1.a = light_channel(1u, true, mv_pos, mv_nrm, clr).a;
+    }
+    out.cc0 = cc0;
+    out.cc1 = cc1;
+
+    // Texture coordinates
+    let tcs = sampled_texcoords();
+    if (tcs != 0u) {
+        let v = TexgenInput(in_vidx, vidx, in_pnmtxidx, in_pos, in_nrm, load_nbt(1u, in_vidx), load_nbt(2u, in_vidx),
+                            cc0, cc1, mv_pos);
+        let tc_count = 32u - countLeadingZeros(tcs); // a run-time bound: not unrolled
+        for (var i = 0u; i < tc_count; i++) {
+            if ((tcs & (1u << i)) == 0u) { continue; }
+            let t = texgen(i, v);
+            switch (i) {
+                case 0u: { out.tex0 = t; }
+                case 1u: { out.tex1 = t; }
+                case 2u: { out.tex2 = t; }
+                case 3u: { out.tex3 = t; }
+                case 4u: { out.tex4 = t; }
+                case 5u: { out.tex5 = t; }
+                case 6u: { out.tex6 = t; }
+                default: { out.tex7 = t; }
+            }
+        }
+    }
+    return out;
+}
+
+// --- Fragment stage ------------------------------------------------------------------------
+
+fn sample_tex(map: u32, uv: vec2f) -> vec4f {
+    let bias = ubuf.tex_size_bias[map].z;
+    switch (map) {
+        case 0u: { return textureSampleBias(tex0, tex0_samp, uv, bias); }
+        case 1u: { return textureSampleBias(tex1, tex1_samp, uv, bias); }
+        case 2u: { return textureSampleBias(tex2, tex2_samp, uv, bias); }
+        case 3u: { return textureSampleBias(tex3, tex3_samp, uv, bias); }
+        case 4u: { return textureSampleBias(tex4, tex4_samp, uv, bias); }
+        case 5u: { return textureSampleBias(tex5, tex5_samp, uv, bias); }
+        case 6u: { return textureSampleBias(tex6, tex6_samp, uv, bias); }
+        default: { return textureSampleBias(tex7, tex7_samp, uv, bias); }
+    }
+}
+
+fn tev_overflow_f32(v: f32) -> f32 {
+    let byte_space = v * 255.0;
+    return (byte_space - floor(byte_space / 256.0) * 256.0) / 255.0;
+}
+fn tev_overflow_vec3f(v: vec3f) -> vec3f {
+    let byte_space = v * 255.0;
+    return (byte_space - floor(byte_space / 256.0) * 256.0) / 255.0;
+}
+
+fn swizzle(v: vec4f, table: u32) -> vec4f {
+    return vec4f(v[swap_sel(table, 0u)], v[swap_sel(table, 1u)], v[swap_sel(table, 2u)], v[swap_sel(table, 3u)]);
+}
+
+struct Stage {
+    a: u32,
+    b: u32,
+    c: u32,
+    d: u32,
+};
+
+// No arrays indexed at run time in the fragment stage: GPUs keep those in (slow) local memory.
+// Registers, texcoords and indirect results are separate values chosen with select chains.
+fn pick4(i: u32, v0: vec4f, v1: vec4f, v2: vec4f, v3: vec4f) -> vec4f {
+    return select(select(select(v0, v1, i == 1u), v2, i == 2u), v3, i == 3u);
+}
+fn pick3(i: u32, v0: vec3f, v1: vec3f, v2: vec3f, v3: vec3f) -> vec3f {
+    return select(select(select(v0, v1, i == 1u), v2, i == 2u), v3, i == 3u);
+}
+
+// A texture coordinate (perspective-divided for GX_TG_MTX3x4).
+fn tex_coord(in: VertexOutput, i: u32) -> vec2f {
+    var v = in.tex7;
+    switch (i) {
+        case 0u: { v = in.tex0; }
+        case 1u: { v = in.tex1; }
+        case 2u: { v = in.tex2; }
+        case 3u: { v = in.tex3; }
+        case 4u: { v = in.tex4; }
+        case 5u: { v = in.tex5; }
+        case 6u: { v = in.tex6; }
+        default: {}
+    }
+    if (bits(tcg(min(i, 7u)), 0u, 4u) == 0u) {
+        return v.xy / v.z;
+    }
+    return v.xy;
+}
+
+fn sample_ind(in: VertexOutput, i: u32) -> vec3f {
+    let s = ind_stage(i);
+    let coord = bits(s, 0u, 4u);
+    let map = bits(s, 4u, 4u);
+    let uv = tex_coord(in, coord) * ubuf.texcoord_scale[coord].xy *
+             vec2f(ind_scale(bits(s, 8u, 4u)), ind_scale(bits(s, 12u, 4u))) / ubuf.tex_size_bias[map].xy;
+    return 255.0 * sample_tex(map, uv).abg;
+}
+
+fn alpha_bump(st: Stage, ind: vec3f) -> f32 {
+    let sel = bits(st.c, 23u, 2u);
+    if (bits(st.c, 16u, 2u) >= num_ind_stages() || sel == 0u) {
+        return 0.0;
+    }
+    let v = ind[sel - 1u];
+    var mask = 0xF8u;
+    let fmt = bits(st.c, 18u, 2u);
+    if (fmt == 1u) {
+        mask = 0xE0u;
+    } else if (fmt == 2u) {
+        mask = 0xF0u;
+    }
+    return f32(u32(v) & mask) / 255.0;
+}
+
+// A color or alpha raster input: the channel's color, or an indirect stage's bump alpha.
+// The raster input's source (pack_uber_config): 0 none, 1/2 color channel 0/1, 3/4 bump alpha
+// (GX_ALPHA_BUMP / GX_ALPHA_BUMPN).
+fn ras_value(st: Stage, rast0: vec4f, rast1: vec4f, ind: vec3f) -> vec4f {
+    let kind = bits(st.d, 9u, 3u);
+    if (kind == 0u) {
+        return vec4f(0.0);
+    }
+    if (ADVANCED && kind >= 3u) {
+        var alpha = alpha_bump(st, ind);
+        if (kind == 4u) {
+            alpha = alpha * (255.0 / 248.0);
+        }
+        return vec4f(alpha);
+    }
+    let c = select(rast0, rast1, kind == 2u);
+    if (bits(st.d, 12u, 1u) != 0u) {
+        return c;
+    }
+    return swizzle(c, bits(st.c, 12u, 2u));
+}
+
+// TEV arguments, branch-free: a color argument is one of 8 values (the registers, the texture, the
+// raster color, (1, 1, 1, 0.5), (konst, 0)), its color or its alpha splat: CPREV/APREV ... ONE/HALF,
+// KONST/ZERO. An alpha argument is the alpha of APREV, A0-A2, TEXA, RASA, KONST, ZERO.
+fn pick8(i: u32, v0: vec4f, v1: vec4f, v2: vec4f, v3: vec4f, v4: vec4f, v5: vec4f, v6: vec4f, v7: vec4f) -> vec4f {
+    let lo = pick4(i & 3u, v0, v1, v2, v3);
+    let hi = pick4(i & 3u, v4, v5, v6, v7);
+    return select(lo, hi, i >= 4u);
+}
+fn color_arg(arg: u32, k: vec4f, r0: vec4f, r1: vec4f, r2: vec4f, r3: vec4f, tex: vec4f, ras: vec4f) -> vec3f {
+    let v = pick8(arg / 2u, r0, r1, r2, r3, tex, ras, vec4f(1.0, 1.0, 1.0, 0.5), vec4f(k.rgb, 0.0));
+    return select(v.rgb, vec3f(v.a), (arg & 1u) != 0u);
+}
+fn alpha_arg(arg: u32, k: vec4f, r0: vec4f, r1: vec4f, r2: vec4f, r3: vec4f, tex: vec4f, ras: vec4f) -> f32 {
+    return pick8(arg, r0, r1, r2, r3, tex, ras, vec4f(k.a), vec4f(0.0)).a;
+}
+
+fn tev_bias(bias: u32) -> f32 {
+    return select(select(0.0, -0.5, bias == 2u), 0.5, bias == 1u);
+}
+fn tev_scaled3(v: vec3f, scale: u32) -> vec3f {
+    switch (scale) {
+        case 1u: { return v * 2.0; }
+        case 2u: { return v * 4.0; }
+        case 3u: { return v / 2.0; }
+        default: { return v; }
+    }
+}
+fn tev_scaled1(v: f32, scale: u32) -> f32 {
+    switch (scale) {
+        case 1u: { return v * 2.0; }
+        case 2u: { return v * 4.0; }
+        case 3u: { return v / 2.0; }
+        default: { return v; }
+    }
+}
+
+fn tev_scale_factor(scale: u32) -> f32 {
+    return select(select(select(1.0, 2.0, scale == 1u), 4.0, scale == 2u), 0.5, scale == 3u);
+}
+
+fn tev_color_op(op: u32, bias: u32, scale: u32, clamped: bool, a: vec3f, b: vec3f, c: vec3f, d: vec3f) -> vec3f {
+    var r: vec3f;
+    let zero = vec3f(0.0);
+    if (op <= 1u) {
+        // GX_TEV_ADD / GX_TEV_SUB, by far the most common: no comparison ops evaluated
+        let m = select(mix(a, b, c), -mix(a, b, c), op == 1u);
+        r = ((m + d) + tev_bias(bias)) * tev_scale_factor(scale);
+        if (clamped) {
+            return clamp(r, vec3f(0.0), vec3f(1.0));
+        }
+        return clamp(r, vec3f(-4.0), vec3f(4.0));
+    }
+    if (!ADVANCED) {
+        return vec3f(0.0);
+    }
+    switch (op) {
+        case 0u: { r = tev_scaled3((mix(a, b, c) + d) + tev_bias(bias), scale); }
+        case 1u: { r = tev_scaled3((-mix(a, b, c) + d) + tev_bias(bias), scale); }
+        case 8u: { r = select(zero, c, round(a.r * 255.0) > round(b.r * 255.0)) + d; }
+        case 9u: { r = select(zero, c, round(a.r * 255.0) == round(b.r * 255.0)) + d; }
+        case 10u: {
+            r = select(zero, c, round(dot(a.rg * 255.0, vec2(1.0, 256.0))) > round(dot(b.rg * 255.0, vec2(1.0, 256.0)))) + d;
+        }
+        case 11u: {
+            r = select(zero, c, round(dot(a.rg * 255.0, vec2(1.0, 256.0))) == round(dot(b.rg * 255.0, vec2(1.0, 256.0)))) + d;
+        }
+        case 12u: {
+            r = select(zero, c, round(dot(a.rgb * 255.0, vec3(1.0, 256.0, 65536.0))) >
+                                round(dot(b.rgb * 255.0, vec3(1.0, 256.0, 65536.0)))) + d;
+        }
+        case 13u: {
+            r = select(zero, c, round(dot(a.rgb * 255.0, vec3(1.0, 256.0, 65536.0))) ==
+                                round(dot(b.rgb * 255.0, vec3(1.0, 256.0, 65536.0)))) + d;
+        }
+        case 14u: { r = select(zero, c, round(a * 255.0) > round(b * 255.0)) + d; }
+        default: { r = select(zero, c, round(a * 255.0) == round(b * 255.0)) + d; }
+    }
+    if (clamped) {
+        return clamp(r, vec3f(0.0), vec3f(1.0));
+    }
+    return clamp(r, vec3f(-4.0), vec3f(4.0));
+}
+
+// The alpha op. For the packed comparisons (8-13) a and b are the stage's color A and B.
+fn tev_alpha_op(op: u32, bias: u32, scale: u32, clamped: bool, a: vec3f, b: vec3f, c: f32, d: f32) -> f32 {
+    var r: f32;
+    if (op <= 1u) {
+        let m = select(mix(a.x, b.x, c), -mix(a.x, b.x, c), op == 1u);
+        r = ((m + d) + tev_bias(bias)) * tev_scale_factor(scale);
+        if (clamped) {
+            return clamp(r, 0.0, 1.0);
+        }
+        return clamp(r, -4.0, 4.0);
+    }
+    if (!ADVANCED) {
+        return 0.0;
+    }
+    switch (op) {
+        case 0u: { r = tev_scaled1((mix(a.x, b.x, c) + d) + tev_bias(bias), scale); }
+        case 1u: { r = tev_scaled1((-mix(a.x, b.x, c) + d) + tev_bias(bias), scale); }
+        case 8u: { r = select(0.0, c, round(a.r * 255.0) > round(b.r * 255.0)) + d; }
+        case 9u: { r = select(0.0, c, round(a.r * 255.0) == round(b.r * 255.0)) + d; }
+        case 10u: {
+            r = select(0.0, c, round(dot(a.rg * 255.0, vec2(1.0, 256.0))) > round(dot(b.rg * 255.0, vec2(1.0, 256.0)))) + d;
+        }
+        case 11u: {
+            r = select(0.0, c, round(dot(a.rg * 255.0, vec2(1.0, 256.0))) == round(dot(b.rg * 255.0, vec2(1.0, 256.0)))) + d;
+        }
+        case 12u: {
+            r = select(0.0, c, round(dot(a.rgb * 255.0, vec3(1.0, 256.0, 65536.0))) >
+                               round(dot(b.rgb * 255.0, vec3(1.0, 256.0, 65536.0)))) + d;
+        }
+        case 13u: {
+            r = select(0.0, c, round(dot(a.rgb * 255.0, vec3(1.0, 256.0, 65536.0))) ==
+                               round(dot(b.rgb * 255.0, vec3(1.0, 256.0, 65536.0)))) + d;
+        }
+        case 14u: { r = select(0.0, c, round(a.x * 255.0) > round(b.x * 255.0)) + d; }
+        default: { r = select(0.0, c, round(a.x * 255.0) == round(b.x * 255.0)) + d; }
+    }
+    if (clamped) {
+        return clamp(r, 0.0, 1.0);
+    }
+    return clamp(r, -4.0, 4.0);
+}
+
+fn ind_scale(s: u32) -> f32 {
+    return 1.0 / f32(1u << s);
+}
+fn ind_wrap(wrap: u32, coord: f32) -> f32 {
+    switch (wrap) {
+        case 1u: { return coord % 256.0; }
+        case 2u: { return coord % 128.0; }
+        case 3u: { return coord % 64.0; }
+        case 4u: { return coord % 32.0; }
+        case 5u: { return coord % 16.0; }
+        case 6u: { return 0.0; }
+        default: { return coord; }
+    }
+}
+
+fn alpha_compare(comp: u32, value: u32, ref_value: u32) -> bool {
+    switch (comp) {
+        case 0u: { return false; }
+        case 1u: { return value < ref_value; }
+        case 2u: { return value == ref_value; }
+        case 3u: { return value <= ref_value; }
+        case 4u: { return value > ref_value; }
+        case 5u: { return value != ref_value; }
+        case 6u: { return value >= ref_value; }
+        default: { return true; }
+    }
+}
+
+@@FRAGMENT_OUTPUT@@
+@fragment
+fn fs_main(in: VertexOutput) -> @@FRAGMENT_OUTPUT_TYPE@@ {
+    let rast0 = in.cc0;
+    let rast1 = in.cc1;
+    let n_ind = num_ind_stages();
+
+    // Indirect stages, each sampled once
+    let used_ind = select(0u, used_ind_stages(), ADVANCED);
+    var ind0 = vec3f(0.0);
+    var ind1 = vec3f(0.0);
+    var ind2 = vec3f(0.0);
+    var ind3 = vec3f(0.0);
+    if ((used_ind & 1u) != 0u) { ind0 = sample_ind(in, 0u); }
+    if ((used_ind & 2u) != 0u) { ind1 = sample_ind(in, 1u); }
+    if ((used_ind & 4u) != 0u) { ind2 = sample_ind(in, 2u); }
+    if ((used_ind & 8u) != 0u) { ind3 = sample_ind(in, 3u); }
+    let any_ind = used_ind != 0u;
+    var t_tex_coord = vec2f(0.0);
+
+    let loads = loads_tev_reg();
+    var r0 = vec4f(0.0);
+    var r1 = vec4f(0.0);
+    var r2 = vec4f(0.0);
+    var r3 = vec4f(0.0);
+    if ((loads & 1u) != 0u) { r0 = ubuf.tevregs[0]; }
+    if ((loads & 2u) != 0u) { r1 = ubuf.tevregs[1]; }
+    if ((loads & 4u) != 0u) { r2 = ubuf.tevregs[2]; }
+    if ((loads & 8u) != 0u) { r3 = ubuf.tevregs[3]; }
+    let count = tev_stage_count();
+    var last = Stage(0u, 0u, 0u, 0u);
+    for (var s = 0u; s < count; s++) {
+        let words = ubuf.cfg[9u + s];
+        let st = Stage(words.x, words.y, words.z, words.w);
+        last = st;
+        let tex_coord_id = bits(st.c, 0u, 4u);
+        let tex_map = bits(st.c, 4u, 4u);
+        let ind_stage_id = bits(st.c, 16u, 2u);
+        let ind = pick3(ind_stage_id, ind0, ind1, ind2, ind3);
+        let ind_mtx = bits(st.c, 25u, 4u);
+        let wrap_s = bits(st.d, 0u, 3u);
+        let wrap_t = bits(st.d, 3u, 3u);
+        let add_prev = bits(st.d, 7u, 1u) != 0u;
+        let uses_sample = bits(st.d, 8u, 1u) != 0u;
