+fn tev_scaled1(v: f32, scale: u32) -> f32 {
+    switch (scale) {
+        case 1u: { return v * 2.0; }
+        case 2u: { return v * 4.0; }
+        case 3u: { return v / 2.0; }
+        default: { return v; }
+    }
