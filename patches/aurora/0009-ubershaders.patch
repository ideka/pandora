+#pragma once
+
+#include "gx.hpp"
+#include "pipeline.hpp"
+
+// Ubershaders: one generic shader that reads the GX state (vertex format, texgens, lighting, TEV
+// stages, indirect texturing, fog, alpha test) from the draw's data instead of baking it in. A draw
+// whose specialized pipeline is still compiling is drawn with it, so nothing is skipped; only the
+// fixed-function pipeline state (blend, depth, cull, write masks, render targets) needs its own
+// pipeline, and there are few of those.
+namespace aurora::gx {
+
+enum class UberShaderMode : u8 {
+  Off,      // draws whose pipeline isn't ready are skipped (aurora's original behavior)
+  Fallback, // draws whose pipeline isn't ready use the ubershader
+  Force,    // every draw uses the ubershader (testing)
+};
+UberShaderMode uber_shader_mode() noexcept;
+void set_uber_shader_mode(UberShaderMode mode) noexcept;
+
+// An ubershader pipeline config: the config's fixed-function state, with the shader part blanked
+// except the primitive's line mode and a marker (ShaderConfig::pad2).
+constexpr u8 UberShaderMarker = 0xA5;
+inline bool is_uber_config(const ShaderConfig& config) noexcept { return config.pad2 == UberShaderMarker; }
+PipelineConfig make_uber_pipeline_config(const PipelineConfig& config) noexcept;
+
+wgpu::ShaderModule build_uber_shader(u8 lineMode, const gfx::RenderTargetLayout& layout,
+                                     DstAlphaMode dstAlphaMode) noexcept;
+
+// The draw's packed shader config, in the storage buffer (its word offset goes in the draw's
+// immediates as cfgBase).
+gfx::Range push_uber_config(const ShaderConfig& config, const ShaderInfo& info) noexcept;
+// The ubershader's uniform (build_uber_uniform, shader_info.hpp): every field any specialized
+// shader can use, in a fixed layout of exactly MaxUniformSize bytes.
+
+} // namespace aurora::gx
