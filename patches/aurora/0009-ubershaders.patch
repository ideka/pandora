+
+// The alpha op. For the packed comparisons (8-13) a and b are the stage's color A and B.
+fn tev_alpha_op(op: u32, bias: u32, scale: u32, clamped: bool, a: vec3f, b: vec3f, c: f32, d: f32) -> f32 {
+    var r: f32;
+    switch (op) {
+        case 0u: { r = tev_scaled1((mix(a.x, b.x, c) + d) + tev_bias(bias), scale); }
+        case 1u: { r = tev_scaled1((-mix(a.x, b.x, c) + d) + tev_bias(bias), scale); }
+        case 8u: { r = select(0.0, c, round(a.r * 255.0) > round(b.r * 255.0)) + d; }
+        case 9u: { r = select(0.0, c, round(a.r * 255.0) == round(b.r * 255.0)) + d; }
+        case 10u: {
+            r = select(0.0, c, round(dot(a.rg * 255.0, vec2(1.0, 256.0))) > round(dot(b.rg * 255.0, vec2(1.0, 256.0)))) + d;
+        }
+        case 11u: {
+            r = select(0.0, c, round(dot(a.rg * 255.0, vec2(1.0, 256.0))) == round(dot(b.rg * 255.0, vec2(1.0, 256.0)))) + d;
+        }
+        case 12u: {
+            r = select(0.0, c, round(dot(a.rgb * 255.0, vec3(1.0, 256.0, 65536.0))) >
+                               round(dot(b.rgb * 255.0, vec3(1.0, 256.0, 65536.0)))) + d;
+        }
+        case 13u: {
+            r = select(0.0, c, round(dot(a.rgb * 255.0, vec3(1.0, 256.0, 65536.0))) ==
+                               round(dot(b.rgb * 255.0, vec3(1.0, 256.0, 65536.0)))) + d;
+        }
+        case 14u: { r = select(0.0, c, round(a.x * 255.0) > round(b.x * 255.0)) + d; }
+        default: { r = select(0.0, c, round(a.x * 255.0) == round(b.x * 255.0)) + d; }
+    }
+    if (clamped) {
+        return clamp(r, 0.0, 1.0);
+    }
+    return clamp(r, -4.0, 4.0);
+}
+
+fn ind_scale(s: u32) -> f32 {
+    return 1.0 / f32(1u << s);
+}
+fn ind_wrap(wrap: u32, coord: f32) -> f32 {
+    switch (wrap) {
+        case 1u: { return coord % 256.0; }
+        case 2u: { return coord % 128.0; }
+        case 3u: { return coord % 64.0; }
+        case 4u: { return coord % 32.0; }
+        case 5u: { return coord % 16.0; }
+        case 6u: { return 0.0; }
+        default: { return coord; }
+    }
+}
+
+fn alpha_compare(comp: u32, value: u32, ref_value: u32) -> bool {
+    switch (comp) {
+        case 0u: { return false; }
+        case 1u: { return value < ref_value; }
+        case 2u: { return value == ref_value; }
+        case 3u: { return value <= ref_value; }
+        case 4u: { return value > ref_value; }
+        case 5u: { return value != ref_value; }
+        case 6u: { return value >= ref_value; }
+        default: { return true; }
+    }
