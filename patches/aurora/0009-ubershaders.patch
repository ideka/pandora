+
+std::atomic<UberShaderMode> sMode = UberShaderMode::Fallback;
+
+// Packed shader config (words in the storage buffer, read by the shader through cfg()):
+constexpr u32 CfgHeader = 0;      // tevStageCount 5 | numIndStages 3 | fogType 5 | fogRange 1 | lineMode 2 |
+                                  // vtxStride 8 | hasNormal 1 | nbt3 1
+constexpr u32 CfgAlphaCmp = 1;    // comp0 3 | op 2 | comp1 3 | enabled 1 | ... | ref0 8 @16 | ref1 8 @24
+constexpr u32 CfgMasks = 2;       // sampledTexCoords 8 | sampledColorChannels 2 | usedIndStages 4 | loadsTevReg 4
+constexpr u32 CfgSwap = 3;        // 4 swap tables x (r, g, b, a) x 2 bits
+constexpr u32 CfgChannels = 4;    // 4 channels x 8 bits: matSrc 1 | ambSrc 1 | diffFn 2 | attnFn 2 | lighting 1
+constexpr u32 CfgTcg = 5;         // 8: type 4 | src 5 | mtx 7 | postMtx 7 | normalize 1 | embossSrc 3
+constexpr u32 CfgIndStages = 13;  // 2 words, 16 bits per stage: texCoord 4 | texMap 4 | scaleS 4 | scaleT 4
+constexpr u32 CfgAttrs = 15;      // 21: attrType 2 | cnt 4 | compType 4 | offset 8 | stride 8 | frac 5 | le 1
+constexpr u32 CfgTev = 36;        // 16 x 4 words (see push_uber_config)
+constexpr u32 CfgWords = CfgTev + 4 * MaxTevStages;
+
+constexpr std::string_view UberSource = R"""(
+diagnostic(off, derivative_uniformity);
+@@ENABLE@@
+const LINE_MODE: u32 = @@LINE_MODE@@u;
+
+struct Light {
+    pos: vec3f,
+    dir: vec3f,
+    color: vec4f,
+    cos_att: vec3f,
+    dist_att: vec3f,
+};
+struct Fog {
+    color: vec4f,
+    a: f32,
+    b: f32,
+    c: f32,
+    range_center: f32,
+    range_k: array<vec4f, 3>,
+};
+struct Uniform {
+    render_viewport_size: vec2f,
+    logical_viewport_size: vec2f,
+    line_width: f32,
+    line_aspect_y: f32,
+    line_tex_offset: f32,
+    line_texcoord_mask: u32,
+    proj: mat4x4f,
+    postex_mtx: array<mat3x4f, 20>,
+    nrm_mtx: array<mat3x4f, 10>,
+    tevregs: array<vec4f, 4>,
+    lights: array<Light, 8>,
+    light_state: vec4u,
+    cc_amb: array<vec4f, 4>,
+    cc_mat: array<vec4f, 4>,
+    kcolor: array<vec4f, 4>,
+    postmtx: array<mat3x4f, 20>,
+    fog: Fog,
+    texcoord_scale: array<vec4f, 8>,
+    ind_mtx: array<mat2x4f, 3>,
+    tex_size_bias: array<vec4f, 8>,
+};
+struct Immediate {
+    vtx_start: u32,
+    current_pnmtx: u32,
+    fog_range_base: u32,
+    cfg_base: u32,
+    array_start0: vec4u,
+    array_start1: vec4u,
+    array_start2: vec4u,
+};
+var<immediate> imm: Immediate;
+
+@group(0) @binding(0)
+var<storage, read> vbuf: array<u32>;
+@group(0) @binding(1)
+var<storage, read> abuf: array<u32>;
+@group(1) @binding(0)
+var<uniform> ubuf: Uniform;
+@group(2) @binding(0) var tex0: texture_2d<f32>;
+@group(2) @binding(1) var tex0_samp: sampler;
+@group(2) @binding(2) var tex1: texture_2d<f32>;
+@group(2) @binding(3) var tex1_samp: sampler;
+@group(2) @binding(4) var tex2: texture_2d<f32>;
+@group(2) @binding(5) var tex2_samp: sampler;
+@group(2) @binding(6) var tex3: texture_2d<f32>;
+@group(2) @binding(7) var tex3_samp: sampler;
+@group(2) @binding(8) var tex4: texture_2d<f32>;
+@group(2) @binding(9) var tex4_samp: sampler;
+@group(2) @binding(10) var tex5: texture_2d<f32>;
+@group(2) @binding(11) var tex5_samp: sampler;
+@group(2) @binding(12) var tex6: texture_2d<f32>;
+@group(2) @binding(13) var tex6_samp: sampler;
+@group(2) @binding(14) var tex7: texture_2d<f32>;
+@group(2) @binding(15) var tex7_samp: sampler;
+
+// --- Config --------------------------------------------------------------------------------
+
+fn cfg(i: u32) -> u32 {
+    return abuf[imm.cfg_base + i];
+}
+fn bits(v: u32, shift: u32, count: u32) -> u32 {
+    return extractBits(v, shift, count);
+}
+fn tev_stage_count() -> u32 { return bits(cfg(0u), 0u, 5u); }
+fn num_ind_stages() -> u32 { return bits(cfg(0u), 5u, 3u); }
+fn fog_type() -> u32 { return bits(cfg(0u), 8u, 5u); }
+fn fog_range_enabled() -> bool { return bits(cfg(0u), 13u, 1u) != 0u; }
+fn vtx_stride() -> u32 { return bits(cfg(0u), 16u, 8u); }
+fn has_normal() -> bool { return bits(cfg(0u), 24u, 1u) != 0u; }
+fn nrm_nbt3() -> bool { return bits(cfg(0u), 25u, 1u) != 0u; }
+fn sampled_texcoords() -> u32 { return bits(cfg(2u), 0u, 8u); }
+fn sampled_channels() -> u32 { return bits(cfg(2u), 8u, 2u); }
+fn used_ind_stages() -> u32 { return bits(cfg(2u), 10u, 4u); }
+fn loads_tev_reg() -> u32 { return bits(cfg(2u), 14u, 4u); }
+fn swap_sel(table: u32, chan: u32) -> u32 { return bits(cfg(3u), table * 8u + chan * 2u, 2u); }
+fn channel(i: u32) -> u32 { return bits(cfg(4u), i * 8u, 8u); }
+fn tcg(i: u32) -> u32 { return cfg(5u + i); }
+fn ind_stage(i: u32) -> u32 { return bits(cfg(13u + i / 2u), (i % 2u) * 16u, 16u); }
+fn attr_word(attr: u32) -> u32 { return cfg(15u + attr); }
+fn attr_type(attr: u32) -> u32 { return attr_word(attr) & 3u; }
+
+// --- Buffer loads (vbuf: vertices, abuf: arrays) ---------------------------------------------
+
+fn load_word(from_abuf: bool, word_idx: u32) -> u32 {
+    if (from_abuf) {
+        if (word_idx < arrayLength(&abuf)) {
+            return abuf[word_idx];
+        }
+        return 0u;
+    }
+    if (word_idx < arrayLength(&vbuf)) {
+        return vbuf[word_idx];
+    }
+    return 0u;
+}
+fn bswap32(v: u32, le: bool) -> u32 {
+    if (le) {
+        return v;
+    }
+    return ((v & 0x000000FFu) << 24u) | ((v & 0x0000FF00u) << 8u) | ((v & 0x00FF0000u) >> 8u) |
+           ((v & 0xFF000000u) >> 24u);
+}
+fn bswap16(v: u32, le: bool) -> u32 {
+    return select(((v & 0xFFu) << 8u) | (v >> 8u), v, le);
+}
+fn load_u8(a: bool, byte_off: u32) -> u32 {
+    let word = load_word(a, byte_off / 4u);
+    return (word >> ((byte_off & 3u) * 8u)) & 0xFFu;
+}
+fn load_u32_raw(a: bool, byte_off: u32) -> u32 {
+    let word_idx = byte_off >> 2u;
+    let sub = byte_off & 3u;
+    let lo = load_word(a, word_idx);
+    if (sub == 0u) {
+        return lo;
+    }
+    let hi = load_word(a, word_idx + 1u);
+    let shift = sub * 8u;
+    return (lo >> shift) | (hi << (32u - shift));
+}
+fn load_u16(a: bool, byte_off: u32, le: bool) -> u32 {
+    let word_idx = byte_off >> 2u;
+    let sub = byte_off & 3u;
+    let word = load_word(a, word_idx);
+    if (sub <= 2u) {
+        return bswap16(extractBits(word, sub * 8u, 16u), le);
+    }
+    let next = load_word(a, word_idx + 1u);
+    let raw = extractBits(word, 24u, 8u) | (extractBits(next, 0u, 8u) << 8u);
+    return bswap16(raw, le);
+}
+fn load_u24(a: bool, byte_off: u32, le: bool) -> u32 {
+    let raw = load_u32_raw(a, byte_off) & 0x00FFFFFFu;
+    if (le) {
+        return raw;
+    }
+    return ((raw & 0x0000FFu) << 16u) | (raw & 0x00FF00u) | ((raw & 0xFF0000u) >> 16u);
+}
+
+// --- Vertex attributes ---------------------------------------------------------------------
+
+struct AttrAddress {
+    offs: u32,
+    from_abuf: bool,
+    le: bool,
+};
+
+fn array_start(attr: u32) -> u32 {
+    let i = attr - 9u;
+    var v = imm.array_start2;
+    if (i < 4u) {
+        v = imm.array_start0;
+    } else if (i < 8u) {
+        v = imm.array_start1;
+    }
+    return v[i % 4u];
+}
+
+fn attr_address(attr: u32, vidx: u32, dl_extra: u32, within: u32) -> AttrAddress {
+    let w = attr_word(attr);
+    let ty = w & 3u;
+    let dl = bits(w, 10u, 8u) + dl_extra;
+    let stride = bits(w, 18u, 8u);
+    let le = bits(w, 31u, 1u) != 0u;
+    let vtx = imm.vtx_start + vidx * vtx_stride() + dl;
+    if (ty == 2u) {
+        return AttrAddress(array_start(attr) + load_u8(false, vtx) * stride + within, true, le);
+    }
+    if (ty == 3u) {
+        return AttrAddress(array_start(attr) + load_u16(false, vtx, false) * stride + within, true, le);
+    }
+    return AttrAddress(vtx + within, false, false);
+}
+
+fn comp_size(comp: u32) -> u32 {
+    switch (comp) {
+        case 0u, 1u: { return 1u; }
+        case 2u, 3u: { return 2u; }
+        default: { return 4u; }
+    }
+}
+
+fn fetch_comp(a: bool, off: u32, comp: u32, frac: u32, le: bool) -> f32 {
+    let div = f32(1u << frac);
+    switch (comp) {
+        case 0u: { return f32(load_u8(a, off)) / div; }
+        case 1u: { return f32((bitcast<i32>(load_u8(a, off)) << 24u) >> 24u) / div; }
+        case 2u: { return f32(load_u16(a, off, le)) / div; }
+        case 3u: { return f32(bitcast<i32>(load_u16(a, off, le) << 16u) >> 16u) / div; }
+        default: { return bitcast<f32>(bswap32(load_u32_raw(a, off), le)); }
+    }
+}
+
+// An attribute's components (count from the config, or `count` if nonzero), zero beyond them.
+fn fetch_attr(attr: u32, vidx: u32, count: u32, dl_extra: u32, within: u32) -> vec4f {
+    let w = attr_word(attr);
+    let comp = bits(w, 6u, 4u);
+    let frac = bits(w, 26u, 5u);
+    var cnt = bits(w, 2u, 4u);
+    if (count != 0u) {
+        cnt = count;
+    }
+    let ad = attr_address(attr, vidx, dl_extra, within);
+    if (comp == 5u) {
+        return unpack4x8unorm(load_u32_raw(ad.from_abuf, ad.offs));
+    }
+    let size = comp_size(comp);
+    var r = vec4f(0.0);
+    for (var k = 0u; k < min(cnt, 4u); k++) {
+        r[k] = fetch_comp(ad.from_abuf, ad.offs + k * size, comp, frac, ad.le);
+    }
+    return r;
+}
+
+fn fetch_color(attr: u32, vidx: u32) -> vec4f {
+    let comp = bits(attr_word(attr), 6u, 4u);
+    let ad = attr_address(attr, vidx, 0u, 0u);
+    let a = ad.from_abuf;
+    switch (comp) {
+        case 0u: {
+            let v = load_u16(a, ad.offs, ad.le);
+            return vec4f(f32((v >> 11u) & 0x1Fu) / f32(0x1Fu), f32((v >> 5u) & 0x3Fu) / f32(0x3Fu),
+                         f32((v >> 0u) & 0x1Fu) / f32(0x1Fu), 1.0);
+        }
+        case 1u, 2u: {
+            let raw = load_u32_raw(a, ad.offs);
+            return vec4f(f32(extractBits(raw, 0u, 8u)), f32(extractBits(raw, 8u, 8u)), f32(extractBits(raw, 16u, 8u)),
+                         255.0) / 255.0;
+        }
+        case 3u: {
+            let v = load_u16(a, ad.offs, ad.le);
+            return vec4f(f32((v >> 12u) & 0x0Fu) / f32(0x0Fu), f32((v >> 8u) & 0x0Fu) / f32(0x0Fu),
+                         f32((v >> 4u) & 0x0Fu) / f32(0x0Fu), f32((v >> 0u) & 0x0Fu) / f32(0x0Fu));
+        }
+        case 4u: {
+            let v = load_u24(a, ad.offs, ad.le);
+            return vec4f(f32((v >> 18u) & 0x3Fu) / f32(0x3Fu), f32((v >> 12u) & 0x3Fu) / f32(0x3Fu),
+                         f32((v >> 6u) & 0x3Fu) / f32(0x3Fu), f32((v >> 0u) & 0x3Fu) / f32(0x3Fu));
+        }
+        default: {
+            let raw = load_u32_raw(a, ad.offs);
+            return vec4f(f32(extractBits(raw, 0u, 8u)), f32(extractBits(raw, 8u, 8u)), f32(extractBits(raw, 16u, 8u)),
+                         f32(extractBits(raw, 24u, 8u))) / 255.0;
+        }
+    }
+}
+
+fn load_pnmtxidx(vidx: u32) -> u32 {
+    if (attr_type(0u) == 0u) {
+        return imm.current_pnmtx;
+    }
+    let ad = attr_address(0u, vidx, 0u, 0u);
+    return load_u8(ad.from_abuf, ad.offs) / 3u;
+}
+fn load_texmtxidx(i: u32, vidx: u32) -> u32 {
+    let ad = attr_address(1u + i, vidx, 0u, 0u);
+    return load_u8(ad.from_abuf, ad.offs);
+}
+fn load_pos(vidx: u32) -> vec3f {
+    return fetch_attr(9u, vidx, 0u, 0u, 0u).xyz;
+}
+fn load_nrm(vidx: u32) -> vec3f {
+    if (attr_type(10u) == 0u) {
+        return vec3f(1.0, 0.0, 0.0);
+    }
+    return fetch_attr(10u, vidx, min(bits(attr_word(10u), 2u, 4u), 3u), 0u, 0u).xyz;
+}
+// Binormal (slice 1) or tangent (slice 2) of an NBT normal.
+fn load_nbt(slice: u32, vidx: u32) -> vec3f {
+    let w = attr_word(10u);
+    let ty = w & 3u;
+    if (ty == 0u || bits(w, 2u, 4u) != 9u) {
+        return vec3f(0.0);
+    }
+    var dl_extra = 0u;
+    if (nrm_nbt3()) {
+        if (ty == 2u) {
+            dl_extra = slice;
+        } else if (ty == 3u) {
+            dl_extra = slice * 2u;
+        }
+    }
+    let size = comp_size(bits(w, 6u, 4u));
+    return fetch_attr(10u, vidx, 3u, dl_extra, slice * 3u * size).xyz;
+}
+fn load_clr(i: u32, vidx: u32) -> vec4f {
+    if (attr_type(11u + i) == 0u) {
+        return vec4f(0.0);
+    }
+    return fetch_color(11u + i, vidx);
+}
+fn load_tex(i: u32, vidx: u32) -> vec2f {
+    return fetch_attr(13u + i, vidx, 0u, 0u, 0u).xy;
+}
+
+// --- Vertex stage --------------------------------------------------------------------------
+
+struct VertexOutput {
+    @builtin(position) pos: vec4f,
+    @location(0) cc0: vec4f,
+    @location(1) cc1: vec4f,
+    @location(2) mv_nrm: vec3f,
+    @location(3) tex0: vec3f,
+    @location(4) tex1: vec3f,
+    @location(5) tex2: vec3f,
+    @location(6) tex3: vec3f,
+    @location(7) tex4: vec3f,
+    @location(8) tex5: vec3f,
+    @location(9) tex6: vec3f,
+    @location(10) tex7: vec3f,
+};
+
+// One color channel (i: 0 or 1; alpha: its alpha half), as lighting_func in shader.cpp.
+fn light_channel(i: u32, alpha: bool, mv_pos: vec3f, mv_nrm: vec3f, clr: vec4f) -> vec4f {
+    let ch = i + select(0u, 2u, alpha);
+    let c = channel(ch);
+    let mat = select(ubuf.cc_mat[ch], clr, bits(c, 0u, 1u) != 0u);
+    if (bits(c, 6u, 1u) == 0u) {
+        return mat;
+    }
+    let amb = select(ubuf.cc_amb[ch], clr, bits(c, 1u, 1u) != 0u);
+    let diff_fn = bits(c, 2u, 2u);
+    let attn_fn = bits(c, 4u, 2u);
+    var lighting = amb;
+    for (var l = 0u; l < 8u; l++) {
+        if ((ubuf.light_state[ch] & (1u << l)) == 0u) { continue; }
+        let light = ubuf.lights[l];
+        var ldir = light.pos - mv_pos;
+        let dist2 = dot(ldir, ldir);
+        let dist = sqrt(dist2);
+        ldir = ldir / dist;
+        var attn: f32;
+        if (attn_fn == 2u) {
+            attn = 1.0;
+        } else if (attn_fn == 1u) {
+            let cosine = max(0.0, dot(ldir, light.dir));
+            let cos_attn = dot(light.cos_att, vec3f(1.0, cosine, cosine * cosine));
+            let dist_attn = dot(light.dist_att, vec3f(1.0, dist, dist2));
+            attn = max(0.0, cos_attn / dist_attn);
+        } else {
+            attn = select(0.0, max(0.0, dot(mv_nrm, light.dir)), dot(mv_nrm, ldir) >= 0.0);
+            let cos_attn = dot(light.cos_att, vec3f(1.0, attn, attn * attn));
+            var dist_attn: f32;
+            if (diff_fn != 0u) {
+                dist_attn = max(0.0, dot(normalize(light.dist_att), vec3f(1.0, attn, attn * attn)));
+            } else {
+                dist_attn = max(0.0, dot(light.dist_att, vec3f(1.0, attn, attn * attn)));
+            }
+            attn = max(0.0, cos_attn / dist_attn);
+        }
+        var diff = 1.0;
+        if (diff_fn == 1u) {
+            diff = dot(ldir, mv_nrm);
+        } else if (diff_fn == 2u) {
+            diff = max(0.0, dot(ldir, mv_nrm));
+        }
+        lighting = lighting + (attn * diff * light.color);
+    }
+    return mat * clamp(lighting, vec4f(0.0), vec4f(1.0));
+}
+
+@vertex
+fn vs_main(
+    @builtin(vertex_index) vidx: u32@@IIDX@@
+) -> VertexOutput {
+    var out: VertexOutput;
+    var in_vidx = vidx;
+    var in_pos: vec3f;
+    var in_pnmtxidx: u32;
+    var mv_pos: vec3f;
+    var mv_pos_a: vec3f;
+    var mv_pos_b: vec3f;
+    var use_b = false;
+    if (LINE_MODE == 3u) {
+        in_vidx = iidx;
+        in_pos = load_pos(in_vidx);
+        in_pnmtxidx = load_pnmtxidx(in_vidx);
+        mv_pos = vec4f(in_pos, 1.0) * ubuf.postex_mtx[in_pnmtxidx];
+    } else if (LINE_MODE != 0u) {
+        use_b = vidx >= 2u;
+        let vidx_a = iidx * select(1u, 2u, LINE_MODE == 1u);
+        let vidx_b = vidx_a + 1u;
+        in_vidx = select(vidx_a, vidx_b, use_b);
+        let pos_a = load_pos(vidx_a);
+        let pos_b = load_pos(vidx_b);
+        in_pos = select(pos_a, pos_b, use_b);
+        let pnmtxidx_a = load_pnmtxidx(vidx_a);
+        let pnmtxidx_b = load_pnmtxidx(vidx_b);
+        in_pnmtxidx = select(pnmtxidx_a, pnmtxidx_b, use_b);
+        mv_pos_a = vec4f(pos_a, 1.0) * ubuf.postex_mtx[pnmtxidx_a];
+        mv_pos_b = vec4f(pos_b, 1.0) * ubuf.postex_mtx[pnmtxidx_b];
+        mv_pos = select(mv_pos_a, mv_pos_b, use_b);
+    } else {
+        in_pnmtxidx = load_pnmtxidx(vidx);
+        in_pos = load_pos(vidx);
+        mv_pos = vec4f(in_pos, 1.0) * ubuf.postex_mtx[in_pnmtxidx];
+    }
+    let in_nrm = load_nrm(in_vidx);
+
+    if (LINE_MODE == 0u) {
+        let clip_pos = vec4f(mv_pos, 1.0) * ubuf.proj;
+        let edge_ndc = clip_pos.xy / clip_pos.w;
+        let half_px_ndc = 1.0 / max(ubuf.logical_viewport_size, vec2f(1.0));
+        let near_edge = (abs(abs(edge_ndc) - 1.0) < half_px_ndc) & vec2<bool>(clip_pos.w > 0.0);
+        out.pos = vec4f(select(edge_ndc, sign(edge_ndc), near_edge) * clip_pos.w, clip_pos.zw);
+    } else if (LINE_MODE == 3u) {
+        let clip = vec4f(mv_pos, 1.0) * ubuf.proj;
+        let viewport_scale = ubuf.render_viewport_size / max(ubuf.logical_viewport_size, vec2f(1.0));
+        let point_size = ubuf.line_width * min(viewport_scale.x, viewport_scale.y);
+        let x_sign = select(-1.0, 1.0, (vidx & 1u) != 0u);
+        let y_sign = select(-1.0, 1.0, vidx >= 2u);
+        let offset_px = vec2f(x_sign, y_sign) * (point_size / 2.0);
+        let offset_ndc = (offset_px * 2.0) / ubuf.render_viewport_size;
+        out.pos = vec4f(clip.xy + offset_ndc * clip.w, clip.zw);
+    } else {
+        let clip_a = vec4f(mv_pos_a, 1.0) * ubuf.proj;
+        let clip_b = vec4f(mv_pos_b, 1.0) * ubuf.proj;
+        let ndc_a = clip_a.xy / clip_a.w;
+        let ndc_b = clip_b.xy / clip_b.w;
+        let viewport_scale = ubuf.render_viewport_size / max(ubuf.logical_viewport_size, vec2f(1.0));
+        let delta_px = (ndc_b - ndc_a) / 2.0 * ubuf.render_viewport_size;
+        let dir_px = select(vec2f(1.0, 0.0), normalize(delta_px), dot(delta_px, delta_px) > 1e-10);
+        let perp_px = vec2f(-dir_px.y, dir_px.x);
+        let line_width = ubuf.line_width * min(viewport_scale.x, viewport_scale.y);
+        let offset_px = perp_px * (line_width / 2.0) * select(-1.0, 1.0, (vidx & 1u) != 0u);
+        let offset_ndc = (offset_px * 2.0) / ubuf.render_viewport_size;
+        let clip_base = select(clip_a, clip_b, use_b);
+        out.pos = vec4f(clip_base.xy + offset_ndc * clip_base.w, clip_base.zw);
+    }
+    let nrm_tmp = vec4f(in_nrm, 0.0) * ubuf.nrm_mtx[in_pnmtxidx];
+    let mv_nrm = select(nrm_tmp, normalize(nrm_tmp), dot(nrm_tmp, nrm_tmp) > 1e-10);
+    out.mv_nrm = mv_nrm;
+
+    // Color channels
+    var cc: array<vec4f, 2>;
+    for (var i = 0u; i < 2u; i++) {
+        if ((sampled_channels() & (1u << i)) == 0u) { continue; }
+        let clr = load_clr(i, in_vidx);
+        cc[i] = light_channel(i, false, mv_pos, mv_nrm, clr);
+        cc[i].a = light_channel(i, true, mv_pos, mv_nrm, clr).a;
+    }
+    out.cc0 = cc[0];
+    out.cc1 = cc[1];
+
+    // Texture coordinates
+    let in_binrm = load_nbt(1u, in_vidx);
+    let in_tangent = load_nbt(2u, in_vidx);
+    var tc: array<vec4f, 8>;
+    var tc_proj: array<vec3f, 8>;
+    var tex_out: array<vec3f, 8>;
+    for (var i = 0u; i < 8u; i++) {
+        if ((sampled_texcoords() & (1u << i)) == 0u) { continue; }
+        let g = tcg(i);
+        let ty = bits(g, 0u, 4u);
+        let src = bits(g, 4u, 5u);
+        let mtx = bits(g, 9u, 7u);
+        let post = bits(g, 16u, 7u);
+        if (ty >= 2u && ty <= 9u) {
+            // Emboss bump: the source texcoord offset by the light projected onto tangent/binormal
+            let bump_ldir = normalize(ubuf.lights[ty - 2u].pos - mv_pos);
+            let bump_tan = vec4f(in_tangent, 0.0) * ubuf.nrm_mtx[in_pnmtxidx];
+            let bump_bin = vec4f(in_binrm, 0.0) * ubuf.nrm_mtx[in_pnmtxidx];
+            tex_out[i] = vec3f(tc_proj[bits(g, 24u, 3u)].xy + vec2f(dot(bump_ldir, bump_tan), dot(bump_ldir, bump_bin)),
+                               1.0);
+            continue;
+        }
+        if (src >= 4u && src <= 11u) {
+            tc[i] = vec4f(load_tex(src - 4u, in_vidx), 1.0, 1.0);
+        } else if (src >= 12u && src <= 18u) {
+            tc[i] = tc[src - 12u];
+        } else if (src == 0u) {
+            tc[i] = vec4f(in_pos, 1.0);
+        } else if (src == 1u) {
+            tc[i] = vec4f(in_nrm, 1.0);
+        } else if (src == 19u) {
+            tc[i] = out.cc0;
+        } else if (src == 20u) {
+            tc[i] = out.cc1;
+        } else if (src == 2u) {
+            tc[i] = vec4f(in_binrm, 1.0);
+        } else if (src == 3u) {
+            tc[i] = vec4f(in_tangent, 1.0);
+        }
+        var tmp: vec3f;
+        if (ty <= 1u) {
+            if (attr_type(1u + i) != 0u) {
+                tmp = tc[i] * ubuf.postex_mtx[load_texmtxidx(i, in_vidx) / 3u];
+            } else if (mtx == 60u) {
+                tmp = tc[i].xyz;
+            } else {
+                tmp = tc[i] * ubuf.postex_mtx[mtx / 3u];
+            }
+            if (ty == 1u) {
+                tmp.z = 1.0;
+            }
+        } else {
+            tmp = vec3f(tc[i].xy, 1.0);
+        }
+        if (bits(g, 23u, 1u) != 0u) {
+            tmp = normalize(tmp);
+        }
+        var proj = tmp;
+        if (post != 125u) {
+            proj = vec4f(tmp.xyz, 1.0) * ubuf.postmtx[(post - 64u) / 3u];
+        }
+        if (LINE_MODE == 3u) {
+            if ((ubuf.line_texcoord_mask & (1u << i)) != 0u) {
+                if ((vidx & 1u) != 0u) { proj.x += ubuf.line_tex_offset; }
+                if (vidx >= 2u) { proj.y += ubuf.line_tex_offset; }
+            }
+        } else if (LINE_MODE != 0u) {
+            if ((ubuf.line_texcoord_mask & (1u << i)) != 0u && (vidx & 1u) != 0u) {
+                proj.y += ubuf.line_tex_offset;
+            }
+        }
+        tc_proj[i] = proj;
+        tex_out[i] = select(vec3f(proj.xy, 1.0), proj, ty == 0u);
+    }
+    out.tex0 = tex_out[0];
+    out.tex1 = tex_out[1];
+    out.tex2 = tex_out[2];
+    out.tex3 = tex_out[3];
+    out.tex4 = tex_out[4];
+    out.tex5 = tex_out[5];
+    out.tex6 = tex_out[6];
+    out.tex7 = tex_out[7];
+    return out;
+}
+
+// --- Fragment stage ------------------------------------------------------------------------
+
+fn sample_tex(map: u32, uv: vec2f) -> vec4f {
+    let bias = ubuf.tex_size_bias[map].z;
+    switch (map) {
+        case 0u: { return textureSampleBias(tex0, tex0_samp, uv, bias); }
+        case 1u: { return textureSampleBias(tex1, tex1_samp, uv, bias); }
+        case 2u: { return textureSampleBias(tex2, tex2_samp, uv, bias); }
+        case 3u: { return textureSampleBias(tex3, tex3_samp, uv, bias); }
+        case 4u: { return textureSampleBias(tex4, tex4_samp, uv, bias); }
+        case 5u: { return textureSampleBias(tex5, tex5_samp, uv, bias); }
+        case 6u: { return textureSampleBias(tex6, tex6_samp, uv, bias); }
+        default: { return textureSampleBias(tex7, tex7_samp, uv, bias); }
+    }
+}
+
+fn tev_overflow_f32(v: f32) -> f32 {
+    let byte_space = v * 255.0;
+    return (byte_space - floor(byte_space / 256.0) * 256.0) / 255.0;
+}
+fn tev_overflow_vec3f(v: vec3f) -> vec3f {
+    let byte_space = v * 255.0;
+    return (byte_space - floor(byte_space / 256.0) * 256.0) / 255.0;
+}
+
+fn swizzle(v: vec4f, table: u32) -> vec4f {
+    return vec4f(v[swap_sel(table, 0u)], v[swap_sel(table, 1u)], v[swap_sel(table, 2u)], v[swap_sel(table, 3u)]);
+}
+
+fn konst_color(sel: u32) -> vec3f {
+    if (sel < 8u) {
+        return vec3f(f32(8u - sel) / 8.0);
+    }
+    if (sel >= 0x0Cu && sel < 0x10u) {
+        return ubuf.kcolor[sel - 0x0Cu].rgb;
+    }
+    if (sel >= 0x10u) {
+        return vec3f(ubuf.kcolor[(sel - 0x10u) % 4u][(sel - 0x10u) / 4u]);
+    }
+    return vec3f(0.0);
+}
+fn konst_alpha(sel: u32) -> f32 {
+    if (sel < 8u) {
+        return f32(8u - sel) / 8.0;
+    }
+    if (sel >= 0x10u) {
+        return ubuf.kcolor[(sel - 0x10u) % 4u][(sel - 0x10u) / 4u];
+    }
+    return 0.0;
+}
+
+struct Stage {
+    a: u32,
+    b: u32,
+    c: u32,
+    d: u32,
+};
+
+fn alpha_bump(st: Stage, ind_in: array<vec3f, 4>) -> f32 {
+    var ind = ind_in;
+    let ind_stage = bits(st.c, 16u, 2u);
+    let sel = bits(st.c, 23u, 2u);
+    if (ind_stage >= num_ind_stages() || sel == 0u) {
+        return 0.0;
+    }
+    let v = ind[ind_stage][sel - 1u];
+    var mask = 0xF8u;
+    let fmt = bits(st.c, 18u, 2u);
+    if (fmt == 1u) {
+        mask = 0xE0u;
+    } else if (fmt == 2u) {
+        mask = 0xF0u;
+    }
+    return f32(u32(v) & mask) / 255.0;
