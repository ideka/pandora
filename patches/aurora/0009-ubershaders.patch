+// A color or alpha raster input: the channel's color, or an indirect stage's bump alpha.
+fn ras_value(st: Stage, rast_in: array<vec4f, 2>, ind: array<vec3f, 4>) -> vec4f {
+    var rast = rast_in;
+    let chan = bits(st.c, 8u, 4u);
+    if (chan == 6u || chan == 15u) {
+        return vec4f(0.0);
+    }
+    if (chan == 7u || chan == 8u) {
+        var alpha = alpha_bump(st, ind);
+        if (chan == 8u) {
+            alpha = alpha * (255.0 / 248.0);
+        }
+        return vec4f(alpha);
+    }
+    let idx = select(0u, 1u, chan == 1u || chan == 3u || chan == 5u);
+    return swizzle(rast[idx], bits(st.c, 12u, 2u));
