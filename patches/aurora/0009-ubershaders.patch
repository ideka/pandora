+                var has_offset = false;
+                if (ind_mtx != 0u && ind_stage_id < n_ind) {
+                    let fmt = bits(st.c, 18u, 2u);
+                    var coord = ind;
+                    if (fmt != 0u) {
+                        coord = floor(coord / f32(4u << fmt));
+                    }
+                    let bias_sel = bits(st.c, 20u, 3u);
+                    if (bias_sel != 0u) {
+                        let bias = select(1.0, -128.0, fmt == 0u);
+                        coord = coord + vec3f(f32(bias_sel & 1u), f32((bias_sel >> 1u) & 1u), f32((bias_sel >> 2u) & 1u)) * bias;
+                    }
+                    if (ind_mtx >= 1u && ind_mtx <= 3u) {
+                        let c0 = ubuf.ind_mtx[ind_mtx - 1u][0];
+                        let c1 = ubuf.ind_mtx[ind_mtx - 1u][1];
+                        offset = vec2f(dot(vec3f(c0.xz, c1.x), coord), dot(vec3f(c0.yw, c1.y), coord)) * c1.z;
+                        has_offset = true;
+                    } else if (ind_mtx >= 5u && ind_mtx <= 7u && has_base_coord) {
+                        offset = base_uv * ubuf.texcoord_scale[tex_coord_id].xy * coord.x *
+                                 ubuf.ind_mtx[ind_mtx - 5u][1][2] / 256.0;
+                        has_offset = true;
+                    } else if (ind_mtx >= 9u && ind_mtx <= 11u && has_base_coord) {
+                        offset = base_uv * ubuf.texcoord_scale[tex_coord_id].xy * coord.y *
+                                 ubuf.ind_mtx[ind_mtx - 9u][1][2] / 256.0;
+                        has_offset = true;
+                    }
+                }
+                let simple = ind_mtx == 0u && !add_prev;
+                var final_coord = vec2f(0.0);
+                var has_final = false;
+                if (has_base_coord) {
+                    var base_coord = base_uv;
+                    if (!simple) {
+                        base_coord = base_coord * ubuf.texcoord_scale[tex_coord_id].xy;
+                    }
+                    if (wrap_s != 0u || wrap_t != 0u) {
+                        base_coord = vec2f(ind_wrap(wrap_s, base_coord.x), ind_wrap(wrap_t, base_coord.y));
+                    }
+                    final_coord = base_coord;
+                    if (has_offset) {
+                        final_coord = base_coord + offset;
+                    }
+                    has_final = true;
+                } else if (has_offset) {
+                    final_coord = offset;
+                    has_final = true;
+                }
+                if (any_ind && has_final) {
+                    if (add_prev) {
+                        t_tex_coord += final_coord;
+                    } else {
+                        t_tex_coord = final_coord;
+                    }
+                    if (uses_sample && has_base_tex) {
+                        uv_in = select(t_tex_coord / ubuf.tex_size_bias[tex_map].xy, t_tex_coord, simple);
+                    }
+                }
+            }
+            if (uses_sample) {
+                tex = sample_tex(tex_map, uv_in);
+                if (bits(st.d, 13u, 1u) == 0u) {
+                    tex = swizzle(tex, bits(st.c, 14u, 2u));
+                }
+            }
+        }
+        let ras = ras_value(st, rast0, rast1, ind);
+
+        // Color
+        let ca = bits(st.a, 0u, 4u);
+        let cb = bits(st.a, 4u, 4u);
+        let cc = bits(st.a, 8u, 4u);
+        let cd = bits(st.a, 12u, 4u);
+        let k = ubuf.konst[s];
+        var a3 = color_arg(ca, k, r0, r1, r2, r3, tex, ras);
+        var b3 = color_arg(cb, k, r0, r1, r2, r3, tex, ras);
+        var c3 = color_arg(cc, k, r0, r1, r2, r3, tex, ras);
+        let d3 = color_arg(cd, k, r0, r1, r2, r3, tex, ras);
+        // Arguments read from registers last written unclamped wrap (flags from pack_uber_config)
+        let wrap = bits(st.d, 14u, 6u);
+        if ((wrap & 1u) != 0u) { a3 = tev_overflow_vec3f(a3); }
+        if ((wrap & 2u) != 0u) { b3 = tev_overflow_vec3f(b3); }
+        if ((wrap & 4u) != 0u) { c3 = tev_overflow_vec3f(c3); }
+        let cout = bits(st.b, 8u, 2u);
+        let cclamp = bits(st.b, 10u, 1u);
+        let color = tev_color_op(bits(st.b, 0u, 4u), bits(st.b, 4u, 2u), bits(st.b, 6u, 2u), cclamp != 0u, a3, b3, c3, d3);
+        r0 = select(r0, vec4f(color, r0.a), cout == 0u);
+        r1 = select(r1, vec4f(color, r1.a), cout == 1u);
+        r2 = select(r2, vec4f(color, r2.a), cout == 2u);
+        r3 = select(r3, vec4f(color, r3.a), cout == 3u);
+
+        // Alpha
+        let aop = bits(st.b, 11u, 4u);
+        let aout = bits(st.b, 19u, 2u);
+        let aclamp = bits(st.b, 21u, 1u);
+        let aa = bits(st.a, 16u, 3u);
+        let ab = bits(st.a, 19u, 3u);
+        let ac = bits(st.a, 22u, 3u);
+        var a1 = alpha_arg(aa, k, r0, r1, r2, r3, tex, ras);
+        var b1 = alpha_arg(ab, k, r0, r1, r2, r3, tex, ras);
+        var c1 = alpha_arg(ac, k, r0, r1, r2, r3, tex, ras);
+        let d1 = alpha_arg(bits(st.a, 25u, 3u), k, r0, r1, r2, r3, tex, ras);
+        if ((wrap & 8u) != 0u) { a1 = tev_overflow_f32(a1); }
+        if ((wrap & 16u) != 0u) { b1 = tev_overflow_f32(b1); }
+        if ((wrap & 32u) != 0u) { c1 = tev_overflow_f32(c1); }
+        var alpha_a = vec3f(a1);
+        var alpha_b = vec3f(b1);
+        if (aop >= 8u && aop <= 13u) {
+            alpha_a = a3;
+            alpha_b = b3;
+        }
+        let alpha = tev_alpha_op(aop, bits(st.b, 15u, 2u), bits(st.b, 17u, 2u), aclamp != 0u, alpha_a, alpha_b, c1, d1);
+        r0.a = select(r0.a, alpha, aout == 0u);
+        r1.a = select(r1.a, alpha, aout == 1u);
+        r2.a = select(r2.a, alpha, aout == 2u);
+        r3.a = select(r3.a, alpha, aout == 3u);
+    }
+    let last_cout = bits(last.b, 8u, 2u);
+    let last_aout = bits(last.b, 19u, 2u);
+    var prev = r0;
+    if (last_cout != 0u) {
+        prev = vec4f(pick4(last_cout, r0, r1, r2, r3).rgb, prev.a);
+    }
+    if (last_aout != 0u) {
+        prev.a = pick4(last_aout, r0, r1, r2, r3).a;
+    }
+
+    // Fog
+    let fog = fog_type();
+    if (fog != 0u) {
+        let fog_depth = @@FOG_DEPTH@@;
+        var fog_base: f32;
+        if ((fog & 0x08u) != 0u) {
+            fog_base = ubuf.fog.a * fog_depth;
+        } else {
+            fog_base = ubuf.fog.a / (ubuf.fog.b - fog_depth);
+        }
+        if (fog_range_enabled()) {
+            fog_base *= bitcast<f32>(abuf[imm.fog_range_base + u32(in.pos.x)]);
+        }
+        var fog_f = clamp(fog_base - ubuf.fog.c, 0.0, 1.0);
+        var fog_z: f32;
+        switch (fog & 7u) {
+            case 2u: { fog_z = fog_f; }
+            case 4u: { fog_z = 1.0 - exp2(-8.0 * fog_f); }
+            case 5u: { fog_z = 1.0 - exp2(-8.0 * fog_f * fog_f); }
+            case 6u: { fog_z = exp2(-8.0 * (1.0 - fog_f)); }
+            default: {
+                fog_f = 1.0 - fog_f;
+                fog_z = exp2(-8.0 * fog_f * fog_f);
+            }
+        }
+        prev = vec4f(mix(prev.rgb, ubuf.fog.color.rgb, clamp(fog_z, 0.0, 1.0)), prev.a);
+    }
+
+    let masks = cfg(2u);
+    if (bits(masks, 18u, 1u) != 0u) {
+        prev = vec4f(tev_overflow_vec3f(prev.rgb), prev.a);
+    }
+    if (bits(masks, 19u, 1u) != 0u) {
+        prev.a = tev_overflow_f32(prev.a);
+    }
+
+    // Alpha compare
+    let ac_word = cfg(1u);
+    if (bits(ac_word, 8u, 1u) != 0u) {
+        let value = u32(round(clamp(prev.a, 0.0, 1.0) * 255.0));
+        let pass0 = alpha_compare(bits(ac_word, 0u, 3u), value, bits(ac_word, 16u, 8u));
+        let pass1 = alpha_compare(bits(ac_word, 5u, 3u), value, bits(ac_word, 24u, 8u));
+        var passed: bool;
+        switch (bits(ac_word, 3u, 2u)) {
+            case 0u: { passed = pass0 && pass1; }
+            case 1u: { passed = pass0 || pass1; }
+            case 2u: { passed = pass0 != pass1; }
+            default: { passed = pass0 == pass1; }
+        }
+        if (!passed) {
+            discard;
+        }
+    }
