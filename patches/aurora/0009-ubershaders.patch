+}
+)""";
+
+void replace_all(std::string& s, std::string_view token, std::string_view value) {
+  for (size_t pos = s.find(token); pos != std::string::npos; pos = s.find(token, pos + value.size())) {
+    s.replace(pos, token.size(), value);
+  }
+}
+
+std::string uber_shader_source(u8 lineMode, u8 features, uint32_t normalAttachment, DstAlphaMode dstAlphaMode) {
+  std::string src{UberSource};
+  replace_all(src, "@@ADVANCED@@", (features & UberFeatureAdvanced) != 0 ? "true" : "false");
+  if ((features & UberFeatureAlphaTest) == 0) {
+    // A shader that may discard can't be depth-tested early: without it, hidden fragments
+    // aren't shaded at all.
+    replace_all(src, "            discard;\n", "");
+  }
+  replace_all(src, "@@ENABLE@@", dstAlphaMode == DstAlphaMode::DualSource ? "enable dual_source_blending;" : "");
+  replace_all(src, "@@LINE_MODE@@", std::to_string(lineMode));
+  replace_all(src, "@@IIDX@@", ",\n    @builtin(instance_index) iidx: u32");
+  replace_all(src, "@@FOG_DEPTH@@", UseReversedZ ? "(1.0 - in.pos.z)" : "in.pos.z");
+  replace_all(src, "@@DST_ALPHA@@", dstAlphaMode == DstAlphaMode::Replace ? "    prev.a = 1.0;\n" : "");
+
+  std::string output;
+  std::string_view outputType = "@location(0) vec4f";
+  std::string ret = "    return prev;";
+  if (normalAttachment != UINT32_MAX) {
+    output = fmt::format(
+        "struct FragmentOutput {{\n"
+        "    @location(0) color: vec4f,\n"
+        "    @location({}) normal: vec4f,\n"
+        "}};\n",
+        normalAttachment);
+    outputType = "FragmentOutput";
+    ret = "    var out: FragmentOutput;\n"
+          "    out.color = prev;\n"
+          "    if (has_normal()) {\n"
+          "        let nrm_len_sq = dot(in.mv_nrm, in.mv_nrm);\n"
+          "        let unit_nrm = select(vec3f(0.0), normalize(in.mv_nrm), nrm_len_sq > 1e-10);\n"
+          "        out.normal = vec4f(unit_nrm * 0.5 + 0.5, select(0.0, 1.0, nrm_len_sq > 1e-10));\n"
+          "    } else {\n"
+          "        out.normal = vec4f(0.5, 0.5, 0.5, 0.0);\n"
+          "    }\n"
+          "    return out;";
+  }
+  if (dstAlphaMode == DstAlphaMode::DualSource) {
+    output = "struct FragmentOutput {\n"
+             "    @location(0) @blend_src(0) color: vec4f,\n"
+             "    @location(0) @blend_src(1) blend: vec4f,\n"
+             "};\n";
+    outputType = "FragmentOutput";
+    ret = "    return FragmentOutput(vec4f(prev.rgb, 1.0), prev);";
+  }
+  replace_all(src, "@@FRAGMENT_OUTPUT_TYPE@@", outputType);
+  replace_all(src, "@@FRAGMENT_OUTPUT@@", output);
+  replace_all(src, "@@FRAGMENT_RETURN@@", ret);
+  return src;
+}
+
+u32 null4(u32 v) { return v == 0xFF ? 15u : v & 15u; }
+} // namespace
+
+UberShaderMode uber_shader_mode() noexcept { return sMode.load(std::memory_order_relaxed); }
+void set_uber_shader_mode(UberShaderMode mode) noexcept { sMode.store(mode, std::memory_order_relaxed); }
+
+PipelineConfig make_uber_pipeline_config(const PipelineConfig& config) noexcept {
+  PipelineConfig uber = config;
+  uber.shaderConfig = {};
+  uber.shaderConfig.lineMode = config.shaderConfig.lineMode;
+  // Without an alpha test the module has no discard, so the GPU can depth-test before shading.
+  // Features (UberFeature*) the module needs: without an alpha test it has no discard, so the GPU
+  // can depth-test before shading; without the advanced ones their code is left out.
+  const auto& sc = config.shaderConfig;
+  bool advanced = false;
+  for (u32 s = 0; s < sc.tevStageCount && s < MaxTevStages; ++s) {
+    const auto& st = sc.tevStages[s];
+    advanced = advanced || st.colorOp.op >= GX_TEV_COMP_R8_GT || st.alphaOp.op >= GX_TEV_COMP_R8_GT ||
+               st.indTexMtxId != GX_ITM_OFF || st.indTexWrapS != GX_ITW_OFF || st.indTexWrapT != GX_ITW_OFF ||
+               st.indTexAddPrev || st.channelId == GX_ALPHA_BUMP || st.channelId == GX_ALPHA_BUMPN;
+  }
+  uber.shaderConfig.pad1 = (static_cast<bool>(sc.alphaCompare) ? UberFeatureAlphaTest : 0) |
+                           (advanced ? UberFeatureAdvanced : 0);
+  uber.shaderConfig.pad2 = UberShaderMarker;
+  return uber;
+}
+
+std::vector<PipelineConfig> uber_prewarm_configs() noexcept {
+  std::vector<PipelineConfig> configs;
+  for (u8 features = 0; features <= (UberFeatureAlphaTest | UberFeatureAdvanced); ++features) {
+    PipelineConfig config{};
+    config.depthFunc = GX_LEQUAL;
+    config.cullMode = GX_CULL_BACK;
+    config.blendMode = GX_BM_NONE;
+    config.blendFacSrc = GX_BL_ONE;
+    config.blendFacDst = GX_BL_ZERO;
+    config.blendOp = GX_LO_CLEAR;
+    config.dstAlpha = UINT32_MAX;
+    config.depthCompare = true;
+    config.depthUpdate = true;
+    config.colorUpdate = true;
+    config.alphaUpdate = true;
+    config.shaderConfig.pad1 = features;
+    config.shaderConfig.pad2 = UberShaderMarker;
+    configs.push_back(config);
+  }
+  return configs;
+}
+
+wgpu::ShaderModule build_uber_shader(u8 lineMode, u8 features, const gfx::RenderTargetLayout& layout,
+                                     DstAlphaMode dstAlphaMode) noexcept {
+  ZoneScoped;
+  uint32_t normalAttachment = UINT32_MAX;
+  for (uint32_t i = 0; i < layout.colorAttachmentCount; ++i) {
+    if (layout.colorAttachments[i].semantic == gfx::ColorAttachmentSemantic::Normal) {
+      normalAttachment = i;
+    }
+  }
+  static std::mutex mutex;
+  static absl::flat_hash_map<u64, wgpu::ShaderModule> modules;
+  const u64 key = u64{lineMode} | u64{normalAttachment & 0xFFu} << 8 | u64{underlying(dstAlphaMode)} << 16 |
+                  u64{features} << 24;
+  std::lock_guard lock{mutex};
+  if (const auto it = modules.find(key); it != modules.end()) {
+    return it->second;
+  }
+  const auto source = uber_shader_source(lineMode, features, normalAttachment, dstAlphaMode);
+  wgpu::ShaderSourceWGSL wgsl{};
+  wgsl.code = source.c_str();
+  const auto label = fmt::format("GX Ubershader {:x}", key);
+  const wgpu::ShaderModuleDescriptor descriptor{
+      .nextInChain = &wgsl,
+      .label = label.c_str(),
+  };
+  auto module = webgpu::g_device.CreateShaderModule(&descriptor);
+  modules.emplace(key, module);
+  Log.info("Built ubershader module {:x}", key);
+  return module;
+}
+
+void pack_uber_config(const ShaderConfig& config, const ShaderInfo& info, UberConfig& w) noexcept {
+  ZoneScoped;
+  w = {};
+  const auto& nrm = config.attrs[GX_VA_NRM];
+  w[CfgHeader] = (config.tevStageCount & 31u) | (config.numIndStages & 7u) << 5 | (config.fogType & 31u) << 8 |
+                 u32{config.fogRangeEnabled} << 13 | u32{config.lineMode} << 14 | u32{config.vtxStride} << 16 |
+                 u32{nrm.attrType != GX_NONE} << 24 | u32{nrm.nbt3} << 25;
+  const auto& ac = config.alphaCompare;
+  w[CfgAlphaCmp] = (ac.comp0 & 7u) | (ac.op & 3u) << 3 | (ac.comp1 & 7u) << 5 | u32{static_cast<bool>(ac)} << 8 |
+                   (ac.ref0 & 0xFFu) << 16 | (ac.ref1 & 0xFFu) << 24;
+  w[CfgMasks] = static_cast<u32>(info.sampledTexCoords.to_ulong()) |
+                static_cast<u32>(info.sampledColorChannels.to_ulong()) << 8 |
+                static_cast<u32>(info.usedIndStages.to_ulong()) << 10 |
+                static_cast<u32>(info.loadsTevReg.to_ulong()) << 14;
+  for (u32 t = 0; t < MaxTevSwap; ++t) {
+    const auto& swap = config.tevSwapTable[t];
+    w[CfgSwap] |= (swap.red & 3u) << (t * 8) | (swap.green & 3u) << (t * 8 + 2) | (swap.blue & 3u) << (t * 8 + 4) |
+                  (swap.alpha & 3u) << (t * 8 + 6);
+  }
+  for (u32 c = 0; c < MaxColorChannels; ++c) {
+    const auto& ch = config.colorChannels[c];
+    w[CfgChannels] |= ((ch.matSrc & 1u) | (ch.ambSrc & 1u) << 1 | (ch.diffFn & 3u) << 2 | (ch.attnFn & 3u) << 4 |
+                       u32{ch.lightingEnabled} << 6)
+                      << (c * 8);
+  }
+  for (u32 i = 0; i < MaxTexCoord; ++i) {
+    const auto& tcg = config.tcgs[i];
+    w[CfgTcg + i] = (tcg.type & 15u) | (tcg.src & 31u) << 4 | (tcg.mtx & 127u) << 9 | (tcg.postMtx & 127u) << 16 |
+                    u32{tcg.normalize} << 23 | (tcg.embossSrc & 7u) << 24;
+  }
+  for (u32 i = 0; i < MaxIndStages; ++i) {
+    const auto& s = config.indStages[i];
+    w[CfgIndStages + i / 2] |=
+        (null4(s.texCoordId) | null4(s.texMapId) << 4 | (s.scaleS & 15u) << 8 | (s.scaleT & 15u) << 12) << (i % 2 * 16);
+  }
+  for (u32 a = 0; a <= GX_VA_TEX7; ++a) {
+    const auto& m = config.attrs[a];
+    w[CfgAttrs + a] = (m.attrType & 3u) | (m.cnt & 15u) << 2 | (m.compType & 15u) << 6 | u32{m.offset} << 10 |
+                      u32{m.stride} << 18 | (m.frac & 31u) << 26 | u32{m.le} << 31;
+  }
+  // Which arguments wrap on overflow: as build_shader_source tracks it, registers whose color or
+  // alpha was last written unclamped (or not yet written) aren't normalized.
+  std::array<bool, MaxTevRegs> colorNormalized{};
+  std::array<bool, MaxTevRegs> alphaNormalized{};
+  const auto colorNorm = [&](GXTevColorArg arg) {
+    switch (arg) {
+    case GX_CC_CPREV: return colorNormalized[GX_TEVPREV];
+    case GX_CC_APREV: return alphaNormalized[GX_TEVPREV];
+    case GX_CC_C0: return colorNormalized[GX_TEVREG0];
+    case GX_CC_A0: return alphaNormalized[GX_TEVREG0];
+    case GX_CC_C1: return colorNormalized[GX_TEVREG1];
+    case GX_CC_A1: return alphaNormalized[GX_TEVREG1];
+    case GX_CC_C2: return colorNormalized[GX_TEVREG2];
+    case GX_CC_A2: return alphaNormalized[GX_TEVREG2];
+    default: return true;
+    }
+  };
+  const auto alphaNorm = [&](GXTevAlphaArg arg) {
+    switch (arg) {
+    case GX_CA_APREV: return alphaNormalized[GX_TEVPREV];
+    case GX_CA_A0: return alphaNormalized[GX_TEVREG0];
+    case GX_CA_A1: return alphaNormalized[GX_TEVREG1];
+    case GX_CA_A2: return alphaNormalized[GX_TEVREG2];
+    default: return true;
+    }
+  };
+  for (u32 s = 0; s < config.tevStageCount && s < MaxTevStages; ++s) {
+    const auto& st = config.tevStages[s];
+    const u32 wrap = u32{!colorNorm(st.colorPass.a)} | u32{!colorNorm(st.colorPass.b)} << 1 |
+                     u32{!colorNorm(st.colorPass.c)} << 2;
+    colorNormalized[st.colorOp.outReg] = st.colorOp.clamp;
+    const u32 wrapAlpha = u32{!alphaNorm(st.alphaPass.a)} | u32{!alphaNorm(st.alphaPass.b)} << 1 |
+                          u32{!alphaNorm(st.alphaPass.c)} << 2;
+    alphaNormalized[st.alphaOp.outReg] = st.alphaOp.clamp;
+    const auto usesSample = [&] {
+      if (st.texMapId == GX_TEXMAP_NULL) {
+        return false;
+      }
+      const auto& c = st.colorPass;
+      const auto& a = st.alphaPass;
+      return c.a == GX_CC_TEXC || c.a == GX_CC_TEXA || c.b == GX_CC_TEXC || c.b == GX_CC_TEXA ||
+             c.c == GX_CC_TEXC || c.c == GX_CC_TEXA || c.d == GX_CC_TEXC || c.d == GX_CC_TEXA ||
+             a.a == GX_CA_TEXA || a.b == GX_CA_TEXA || a.c == GX_CA_TEXA || a.d == GX_CA_TEXA;
+    }();
+    auto& base = *reinterpret_cast<std::array<u32, 4>*>(&w[CfgTev + s * 4]);
+    base[0] = (st.colorPass.a & 15u) | (st.colorPass.b & 15u) << 4 | (st.colorPass.c & 15u) << 8 |
+              (st.colorPass.d & 15u) << 12 | (st.alphaPass.a & 7u) << 16 | (st.alphaPass.b & 7u) << 19 |
+              (st.alphaPass.c & 7u) << 22 | (st.alphaPass.d & 7u) << 25;
+    base[1] = (st.colorOp.op & 15u) | (st.colorOp.bias & 3u) << 4 | (st.colorOp.scale & 3u) << 6 |
+              (st.colorOp.outReg & 3u) << 8 | u32{st.colorOp.clamp} << 10 | (st.alphaOp.op & 15u) << 11 |
+              (st.alphaOp.bias & 3u) << 15 | (st.alphaOp.scale & 3u) << 17 | (st.alphaOp.outReg & 3u) << 19 |
+              u32{st.alphaOp.clamp} << 21 | (st.kcSel & 31u) << 22 | (st.kaSel & 31u) << 27;
+    base[2] = null4(st.texCoordId) | null4(st.texMapId) << 4 | null4(st.channelId) << 8 | (st.tevSwapRas & 3u) << 12 |
+              (st.tevSwapTex & 3u) << 14 | (st.indTexStage & 3u) << 16 | (st.indTexFormat & 3u) << 18 |
+              (st.indTexBiasSel & 7u) << 20 | (st.indTexAlphaSel & 3u) << 23 | (st.indTexMtxId & 15u) << 25;
+    u32 rasKind = 0;
+    if (st.channelId == GX_ALPHA_BUMP) {
+      rasKind = 3;
+    } else if (st.channelId == GX_ALPHA_BUMPN) {
+      rasKind = 4;
+    } else if (st.channelId != GX_COLOR_ZERO && st.channelId != GX_COLOR_NULL) {
+      rasKind = 1 + color_channel(st.channelId);
+    }
+    const TevSwap identity{};
+    base[3] = (st.indTexWrapS & 7u) | (st.indTexWrapT & 7u) << 3 | u32{st.indTexUseOrigLOD} << 6 |
+              u32{st.indTexAddPrev} << 7 | u32{usesSample} << 8 | rasKind << 9 |
+              u32{config.tevSwapTable[st.tevSwapRas] == identity} << 12 |
+              u32{config.tevSwapTable[st.tevSwapTex] == identity} << 13 | wrap << 14 | wrapAlpha << 17 |
+              u32{st.texCoordId < MaxTexCoord && config.tcgs[st.texCoordId].type == GX_TG_MTX3x4} << 20;
+  }
+  if (config.tevStageCount > 0) {
+    const auto& last = config.tevStages[std::min<u32>(config.tevStageCount, MaxTevStages) - 1];
+    w[CfgMasks] |= u32{!colorNormalized[last.colorOp.outReg]} << 18 | u32{!alphaNormalized[last.alphaOp.outReg]} << 19;
+  }
+}
+
+} // namespace aurora::gx
+
+void aurora_set_ubershader_mode(int mode) {
+  aurora::gx::set_uber_shader_mode(mode <= 0   ? aurora::gx::UberShaderMode::Off
+                                   : mode == 1 ? aurora::gx::UberShaderMode::Fallback
+                                               : aurora::gx::UberShaderMode::Force);
+}
diff --git a/lib/gx/ubershader.hpp b/lib/gx/ubershader.hpp
new file mode 100644
--- /dev/null
+++ b/lib/gx/ubershader.hpp
@@ -0,0 +1,48 @@
+#pragma once
+
+#include "gx.hpp"
+#include "pipeline.hpp"
+
+#include <vector>
+
+// Ubershaders: one generic shader that reads the GX state (vertex format, texgens, lighting, TEV
+// stages, indirect texturing, fog, alpha test) from the draw's data instead of baking it in. A draw
+// whose specialized pipeline is still compiling is drawn with it, so nothing is skipped; only the
+// fixed-function pipeline state (blend, depth, cull, write masks, render targets) needs its own
+// pipeline, and there are few of those.
+namespace aurora::gx {
+
+enum class UberShaderMode : u8 {
+  Off,      // draws whose pipeline isn't ready are skipped (aurora's original behavior)
+  Fallback, // draws whose pipeline isn't ready use the ubershader
+  Force,    // every draw uses the ubershader (testing)
+};
+UberShaderMode uber_shader_mode() noexcept;
+void set_uber_shader_mode(UberShaderMode mode) noexcept;
+
+// An ubershader pipeline config: the config's fixed-function state, with the shader part blanked
+// except the primitive's line mode, the module features it needs (ShaderConfig::pad1) and a marker
+// (ShaderConfig::pad2).
+constexpr u8 UberShaderMarker = 0xA5;
+inline bool is_uber_config(const ShaderConfig& config) noexcept { return config.pad2 == UberShaderMarker; }
+PipelineConfig make_uber_pipeline_config(const PipelineConfig& config) noexcept;
+// Ubershader pipelines for each main module variant (triangles, every feature combination), built
+// in the background at startup so the modules are compiled before the game needs them.
+std::vector<PipelineConfig> uber_prewarm_configs() noexcept;
+
+// Module features (ShaderConfig::pad1 of an ubershader pipeline config)
+constexpr u8 UberFeatureAlphaTest = 1;
+constexpr u8 UberFeatureAdvanced = 2; // indirect texturing, comparison TEV ops, bump alpha
+wgpu::ShaderModule build_uber_shader(u8 lineMode, u8 features, const gfx::RenderTargetLayout& layout,
+                                     DstAlphaMode dstAlphaMode) noexcept;
+
+// The draw's packed shader config, which ends the ubershader's uniform.
+constexpr u32 UberCfgWords = 100;
+using UberConfig = std::array<u32, UberCfgWords>;
+void pack_uber_config(const ShaderConfig& config, const ShaderInfo& info, UberConfig& out) noexcept;
+// The ubershader's uniform (build_uber_uniform, shader_info.hpp): every field any specialized
+// shader can use, in a fixed layout, then the config.
+constexpr u32 UberUniformSize = 3840 + UberCfgWords * 4 + MaxTevStages * 16; // + each stage's konst
+static_assert(UberUniformSize <= MaxUniformSize);
+
+} // namespace aurora::gx
