+        case 1u: { return regs[1].a; }
+        case 2u: { return regs[2].a; }
+        case 3u: { return regs[3].a; }
+        case 4u: { return tex.a; }
+        case 5u: { return ras.a; }
+        case 6u: { return konst_alpha(bits(st.b, 27u, 5u)); }
+        default: { return 0.0; }
