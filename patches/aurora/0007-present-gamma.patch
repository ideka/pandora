diff --git a/include/aurora/aurora.h b/include/aurora/aurora.h
--- a/include/aurora/aurora.h
+++ b/include/aurora/aurora.h
@@ -141,6 +141,9 @@ void aurora_set_timescale(float scale);
 /** Keep the previous frame's EFB contents at the start of each frame instead of clearing them (e.g. to show
  * the last frame under a pause menu while the game issues no draws). */
 void aurora_set_preserve_frame(bool preserve);
+/** Output gamma applied when presenting (before UI overlays): color = color^exponent. Default 1.0f
+ * (e.g. the Wii's video encoder gamma g is exponent 1/g). */
+void aurora_set_present_gamma(float exponent);
 
 SDL_Window* aurora_get_window();
 AuroraWindowSize aurora_get_window_size();
diff --git a/lib/webgpu/gpu.cpp b/lib/webgpu/gpu.cpp
--- a/lib/webgpu/gpu.cpp
+++ b/lib/webgpu/gpu.cpp
@@ -91,13 +91,16 @@ struct ResampleUniformBlock {
   uint32_t samplerMode = 0;
   float frameWidth = 0.f;
   float frameHeight = 0.f;
+  float gamma = 1.f;
 };
+static float g_presentGamma = 1.f;
 
 constexpr std::string_view resampleShaderSource = R"(
 struct Uniforms {
     sampler_mode: u32,
     frame_width: f32,
     frame_height: f32,
+    gamma: f32,
 };
 
 struct VertexOutput {
@@ -183,6 +186,9 @@ fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
     if (uniforms.sampler_mode == 1u) {
         color = sample_area(in.position);
     }
+    if (uniforms.gamma != 1.0) {
+        color = vec4(pow(max(color.rgb, vec3(0.0)), vec3(uniforms.gamma)), color.a);
+    }
     return vec4(color.rgb, 1.0);
 }
 )"sv;
@@ -676,6 +682,7 @@ const TextureWithSampler& resample_present_source(const wgpu::CommandEncoder& en
       .samplerMode = sampler_mode(g_Resampler),
       .frameWidth = static_cast<float>(width),
       .frameHeight = static_cast<float>(height),
+      .gamma = g_presentGamma,
   };
   AURORA_ASSERT(gfx::render_worker::is_worker_thread(), "Present resample queue write must run on the render worker");
   g_queue.WriteBuffer(g_ResampleUniformBuffer, 0, &uniform, sizeof(uniform));
@@ -1190,3 +1197,5 @@ void aurora_enable_vsync(const bool enabled) {
       aurora::webgpu::select_present_mode(aurora::webgpu::g_surfaceCapabilities);
   aurora::window::push_custom_event(aurora::window::CustomEvent::RefreshSurface);
 }
+
+void aurora_set_present_gamma(float exponent) { aurora::webgpu::g_presentGamma = exponent > 0.f ? exponent : 1.f; }
