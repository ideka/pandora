+// One pass of a separable Gaussian. Pairs of taps share one bilinear sample, placed between them
+// by their weights.
+static constexpr std::string_view BlurShader = R"(
+@group(0) @binding(0) var src_samp: sampler;
+@group(0) @binding(1) var src: texture_2d<f32>;
+
+struct BlurUniforms {
+    step: vec2f,
+    sigma: f32,
+    radius: u32,
+};
+@group(0) @binding(2) var<uniform> ubuf: BlurUniforms;
+
+struct VertexOutput {
+    @builtin(position) pos: vec4f,
+    @location(0) uv: vec2f,
+};
+
+var<private> positions: array<vec2f, 3> = array(
+    vec2f(-1.0, 1.0),
+    vec2f(-1.0, -3.0),
+    vec2f(3.0, 1.0),
+);
+var<private> uvs: array<vec2f, 3> = array(
+    vec2f(0.0, 0.0),
+    vec2f(0.0, 2.0),
+    vec2f(2.0, 0.0),
+);
+
+@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
+    var out: VertexOutput;
+    out.pos = vec4f(positions[vi], 0.0, 1.0);
+    out.uv = uvs[vi];
+    return out;
+}
+
+@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
+    let k = -0.5 / (ubuf.sigma * ubuf.sigma);
+    var sum = textureSampleLevel(src, src_samp, in.uv, 0.0);
+    var total = 1.0;
+    for (var i = 1u; i <= ubuf.radius; i += 2u) {
+        let a = f32(i);
+        let b = a + 1.0;
+        let wa = exp(k * a * a);
+        let wb = exp(k * b * b);
+        let w = wa + wb;
+        let o = ubuf.step * ((a * wa + b * wb) / w);
+        sum += (textureSampleLevel(src, src_samp, in.uv + o, 0.0) +
+                textureSampleLevel(src, src_samp, in.uv - o, 0.0)) * w;
+        total += 2.0 * w;
+    }
+    return sum / total;
+}
+)"sv;
+
+static const wgpu::RenderPipeline& blur_pipeline(wgpu::TextureFormat format) {
+  auto& pipeline = g_blurPipelines[format];
+  if (!pipeline) {
+    pipeline = create_pipeline({GX_TF_RGBA8, "", format, "TexCopyConv Blur"}, BlurShader, g_bindGroupLayout);
+  }
+  return pipeline;
+}
+
+static void blur_pass(const wgpu::CommandEncoder& cmd, const wgpu::RenderPipeline& pipeline,
+                      const wgpu::TextureView& src, const wgpu::TextureView& dst, const Range& uniformRange) {
+  const std::array bindGroupEntries{
+      wgpu::BindGroupEntry{
+          .binding = 0,
+          .sampler = g_linearSampler,
+      },
+      wgpu::BindGroupEntry{
+          .binding = 1,
+          .textureView = src,
+      },
+      wgpu::BindGroupEntry{
+          .binding = 2,
+          .buffer = detail::resources().uniformBuffer,
+          .offset = uniformRange.offset,
+          .size = uniformRange.size,
+      },
+  };
+  const wgpu::BindGroupDescriptor bindGroupDescriptor{
+      .layout = g_bindGroupLayout,
+      .entryCount = bindGroupEntries.size(),
+      .entries = bindGroupEntries.data(),
+  };
+  const auto bindGroup = g_device.CreateBindGroup(&bindGroupDescriptor);
+  const std::array colorAttachments{
+      wgpu::RenderPassColorAttachment{
+          .view = dst,
+          .loadOp = wgpu::LoadOp::Clear,
+          .storeOp = wgpu::StoreOp::Store,
+          .clearValue = {0.0, 0.0, 0.0, 0.0},
+      },
+  };
+  const wgpu::RenderPassDescriptor renderPassDescriptor{
+      .label = "TexCopyConv Blur Pass",
+      .colorAttachmentCount = colorAttachments.size(),
+      .colorAttachments = colorAttachments.data(),
+      .timestampWrites = webgpu::gpu_prof::pass_writes("Copy blur"),
+  };
+  const auto pass = cmd.BeginRenderPass(&renderPassDescriptor);
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, bindGroup);
+  pass.Draw(3);
+  pass.End();
+}
+
+void blur(const wgpu::CommandEncoder& cmd, const TextureHandle& tex, const std::array<Range, 2>& uniformRanges) {
+  const auto& pipeline = blur_pipeline(tex->format);
+  if (!pipeline) {
+    return;
+  }
+  if (!g_blurScratch || g_blurScratch->size.width != tex->size.width ||
+      g_blurScratch->size.height != tex->size.height || g_blurScratch->format != tex->format) {
+    const wgpu::TextureDescriptor descriptor{
+        .label = "TexCopyConv Blur Scratch",
+        .usage = wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::RenderAttachment,
+        .size = {tex->size.width, tex->size.height, 1},
+        .format = tex->format,
+    };
+    auto texture = g_device.CreateTexture(&descriptor);
+    auto view = texture.CreateView();
+    g_blurScratch = std::make_shared<TextureRef>(texture, view, view, descriptor.size, tex->format, 1, 0);
+  }
+  blur_pass(cmd, pipeline, tex->sampleTextureView, g_blurScratch->attachmentTextureView, uniformRanges[0]);
+  blur_pass(cmd, pipeline, g_blurScratch->sampleTextureView, tex->attachmentTextureView, uniformRanges[1]);
+}
