+void blur_texture(TextureHandle texture, float sigma) {
+  if (!g_recorder.active() || g_recorder.currentRenderPass == UINT32_MAX || g_recorder.inOffscreen || !texture) {
+    return;
+  }
+  auto& prevPass = current_render_passes()[g_recorder.currentRenderPass];
+  const auto& size = texture->size;
+  const auto radius = std::min<uint32_t>(static_cast<uint32_t>(std::ceil(sigma * 3.f)), 128);
+  prevPass.blurUniformRanges = {
+      push_uniform(tex_copy_conv::BlurUniforms{
+          .step = {1.f / static_cast<float>(size.width), 0.f}, .sigma = sigma, .radius = radius}),
+      push_uniform(tex_copy_conv::BlurUniforms{
+          .step = {0.f, 1.f / static_cast<float>(size.height)}, .sigma = sigma, .radius = radius}),
+  };
+  prevPass.blurTarget = std::move(texture);
+  // Seal the current EFB pass and continue on a new one that loads the existing contents.
+  enqueue_pass(current_frame_packet(), g_recorder.currentRenderPass);
+  resume_efb_pass_loading(prevPass);
+}
